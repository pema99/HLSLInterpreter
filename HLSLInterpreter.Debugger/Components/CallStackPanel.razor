@using HLSL
@using HLSLInterpreter.Debugger.Core
@inherits StateAwareComponent

<div class="debug-section debug-section-callstack @(collapsed ? "section-collapsed" : "")">
    <div class="panel-header collapsible-header" @onclick="ToggleCollapsed">
        <div class="panel-header-left">
            <span class="collapse-icon @(collapsed ? "" : "expanded")">&#x203A;</span>
            <span>Call Stack</span>
        </div>
        @if (!collapsed && ThreadStates.Length > 0 && DebugBottomMode == "ThreadStates")
        {
            <span class="thread-legend">
                <span class="tl-dot tc-active"></span>Active thread
                <span class="tl-dot tc-diverged"></span>Inactive thread
            </span>
        }
    </div>
    @if (!collapsed)
    {
        <div class="callstack-exec-body">
            <div class="callstack-pane">
                @if (Step is { } cstep)
                {
                    var stack = cstep.CallStack;
                    <table class="var-table">
                        <tbody>
                            @for (int i = 0; i < stack.Length; i++)
                            {
                                var fi = i;
                                <tr class="@(fi == State.SelectedFrame ? "callstack-selected" : "")"
                                    @onclick="() => State.SelectedFrame = fi"
                                    style="cursor: pointer;">
                                    <td class="var-name">@stack[i]</td>
                                </tr>
                            }
                            <tr style="cursor: default;">
                                <td class="var-name" style="color: #555; font-style: italic;">[Globals]</td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="hint">Use Step or Continue to inspect call stack.</div>
                }
            </div>
            @{
                bool showImage = DebugBottomMode == "PixelColors" || DebugBottomMode == "Both";
            }
            @if (ThreadStates.Length > 0 || showImage)
            {
                <div class="resize-inner-h-handle" id="callstack-exec-divider"></div>
                <div class="exec-state-pane">
                    <div class="exec-state-body" id="thread-grid-container">
                        @if (showImage)
                        {
                            <div class="image-container" id="image-container-debug" data-mode-target="debug">
                                <canvas class="image-canvas color-canvas-2d"></canvas>
                                <canvas class="image-overlay"></canvas>
                            </div>
                        }
                        else
                        {
                            <div class="thread-grid">
                                @for (int ti = 0; ti < ThreadStates.Length; ti++)
                                {
                                    var tidx = ti;
                                    var state = ThreadStates[ti];
                                    var stateClass = state switch {
                                        HLSLExecutionState.ThreadState.Active    => "tc-active",
                                        HLSLExecutionState.ThreadState.Inactive  => "tc-diverged",
                                        HLSLExecutionState.ThreadState.Suspended => "tc-suspended",
                                        _ => ""
                                    };
                                    var label = $"Thread ({ti % State.WarpX}, {ti / State.WarpX}) - {state}";
                                    <div class="thread-cell @stateClass @(tidx == State.InspectedThread ? "tc-selected" : "")"
                                         title="@label"
                                         @onclick="() => State.InspectedThread = tidx"></div>
                                }
                            </div>
                        }
                    </div>
                    <div class="bottom-mode-row">
                        <label>Mode</label>
                        <select value="@DebugBottomMode" @onchange="OnModeChanged">
                            <option value="ThreadStates">Thread states</option>
                            <option value="PixelColors">Pixel colors</option>
                            <option value="Both">Both</option>
                        </select>
                    </div>
                </div>
            }
        </div>
        <div class="resize-v-handle" title="Drag to resize"></div>
    }
</div>

@code {
    [Parameter] public DebuggerSession.Step? Step { get; set; }
    [Parameter] public string DebugBottomMode { get; set; } = "ThreadStates";
    [Parameter] public EventCallback<string> DebugBottomModeChanged { get; set; }
    [Parameter] public HLSLExecutionState.ThreadState[] ThreadStates { get; set; } = Array.Empty<HLSLExecutionState.ThreadState>();
    [Parameter] public EventCallback OnExpand { get; set; }

    private bool collapsed;

    private async Task ToggleCollapsed()
    {
        collapsed = !collapsed;
        if (!collapsed) await OnExpand.InvokeAsync();
    }

    private async Task OnModeChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "ThreadStates";
        await DebugBottomModeChanged.InvokeAsync(v);
    }
}
