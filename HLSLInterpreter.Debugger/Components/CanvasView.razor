@inherits DebuggerComponent<DebuggerModel>
@using HLSL

@* The image canvas. Every render pushes overlay state to JS, and the image
   whenever it changes. JS keeps no copy. *@
<div class="image-container @CssClass" id="@ContainerId" data-mode-target="@ModeTarget"
     style="@(Hidden ? "display:none" : "")"
     @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true" @oncontextmenu="@(() => {})">
    <canvas class="image-canvas color-canvas-2d"></canvas>
    @if (WithGpuCanvas)
    {
        <canvas id="color-canvas-gpu" class="image-canvas"></canvas>
    }
    <canvas class="image-overlay"></canvas>
</div>

@code {
    [Parameter] public string ContainerId { get; set; }
    [Parameter] public string ModeTarget { get; set; }
    [Parameter] public string CssClass { get; set; }
    [Parameter] public bool Hidden { get; set; }
    [Parameter] public bool WithGpuCanvas { get; set; }

    private ShaderImage _lastImage;

    protected override DebuggerModel Select(DebuggerModel s) => s;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await CanvasInterop.ApplyState(ContainerId, BuildOverlay(Slice));
        // Push the image when this canvas first appears or when a new one is produced.
        var image = Slice.Run.Image;
        if (firstRender || !ReferenceEquals(image, _lastImage))
        {
            _lastImage = image;
            if (image != null)
                await CanvasInterop.SetPixels(image.Pixels, image.Width, image.Height);
        }
    }

    private static Overlay BuildOverlay(DebuggerModel s)
    {
        var config = s.Editor.ActiveDocument?.Config ?? new ShaderConfig();
        int wx = Math.Max(1, config.WarpX);
        int wy = Math.Max(1, config.WarpY);
        bool debugging = s.Debug.IsActive;

        string regularMode = s.Run.Backend == RunBackend.Gpu ? "gpu" : "cpu";
        string debugMode = debugging
            ? s.Debug.BottomMode switch
            {
                DebugBottomMode.Both => "both",
                DebugBottomMode.PixelColors => "debug",
                _ => "idle",
            }
            : "idle";

        Point debugPixel = debugging
            ? new Point(s.Debug.InspectedThread % wx, s.Debug.InspectedThread / wx)
            : null;

        int[] threadStates = debugging
            ? (s.Debug.CurrentStep?.GetThreadStatesAt(s.Debug.SelectedFrame)
                ?? Array.Empty<HLSLExecutionState.ThreadState>()).Select(x => (int)x).ToArray()
            : null;

        bool vertexPick = !debugging
            && config.RenderMode == ShaderRenderMode.VertFrag
            && config.DebugTarget == DebugTarget.Vertex;

        return new Overlay(
            wx, wy, regularMode, debugMode, debugPixel, threadStates,
            debugging, vertexPick ? "vertex" : "pixel");
    }

    private sealed record Overlay(
        int WarpX, int WarpY, string RegularMode, string DebugMode,
        Point DebugPixel, int[] ThreadStates, bool DebugClick, string PickMode);

    private sealed record Point(int X, int Y);
}
