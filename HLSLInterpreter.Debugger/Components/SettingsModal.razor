@inherits StateAwareComponent
@using HLSLInterpreter.Debugger.Services
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">Settings</div>
            <div class="modal-body">
                <div class="settings-row">
                    <label class="settings-label">Render mode</label>
                    <select class="settings-text-input"
                            value="@State.ShaderRenderMode"
                            @onchange="@(e => SetShaderRenderMode(e.Value?.ToString()))"
                            disabled="@IsLocked" title="Frag only: Fullscreen quad fragment shader. Vert/Frag: Custom vertex and fragment shader.">
                        <option value="@ShaderRenderMode.Pixel">Frag only</option>
                        <option value="@ShaderRenderMode.VertFrag">Vert/Frag</option>
                    </select>
                </div>
                @if (State.ShaderRenderMode == ShaderRenderMode.VertFrag)
                {
                    <div class="settings-row">
                        <label class="settings-label">Mesh</label>
                        <button class="settings-text-input" @onclick="PickMesh" disabled="@IsLocked"
                                title="Pick a .obj file to use as the mesh">Pick .obj file...</button>
                    </div>
                    <div class="settings-row">
                        <label class="settings-label">Vertex entry</label>
                        <input class="settings-text-input" type="text"
                               value="@State.VertexEntryPoint"
                               @oninput="@(e => State.VertexEntryPoint = e.Value?.ToString() ?? "")"
                               disabled="@IsLocked" title="Vertex shader function name" />
                    </div>
                }
                <div class="settings-row">
                    <label class="settings-label">@(State.ShaderRenderMode == ShaderRenderMode.VertFrag ? "Frag entry" : "Entry point")</label>
                    <input class="settings-text-input" type="text"
                           value="@State.FragmentEntryPoint"
                           @oninput="@(e => State.FragmentEntryPoint = e.Value?.ToString() ?? "")"
                           disabled="@IsLocked" title="Fragment shader function name" />
                </div>
                <div class="settings-row">
                    <label class="settings-label">Group offset</label>
                    <div class="warp-control">
                        <input class="warp-input" type="number" min="0"
                               value="@State.GroupOffsetX"
                               @oninput="@(e => SetInt(e, v => State.GroupOffsetX = v))"
                               disabled="@IsLocked" title="Group X" />
                        <span class="warp-sep">×</span>
                        <input class="warp-input" type="number" min="0"
                               value="@State.GroupOffsetY"
                               @oninput="@(e => SetInt(e, v => State.GroupOffsetY = v))"
                               disabled="@IsLocked" title="Group Y" />
                    </div>
                </div>
                <div class="settings-row">
                    <label class="settings-label">Warp size</label>
                    <div class="warp-control">
                        <input class="warp-input" type="number" min="1" max="32"
                               value="@State.WarpX"
                               @oninput="@(e => SetInt(e, v => State.WarpX = v))"
                               disabled="@IsLocked" title="Warp X" />
                        <span class="warp-sep">×</span>
                        <input class="warp-input" type="number" min="1" max="32"
                               value="@State.WarpY"
                               @oninput="@(e => SetInt(e, v => State.WarpY = v))"
                               disabled="@IsLocked" title="Warp Y" />
                    </div>
                </div>
                <div class="settings-row">
                    <label class="settings-label">Font size</label>
                    <select class="settings-text-input"
                            value="@State.EditorFontSize"
                            @onchange="OnFontSizeChanged"
                            title="Editor font size">
                        @foreach (var size in fontSizes)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </div>
                <div class="settings-row">
                    <label class="settings-label">CPU full frame</label>
                    <label class="settings-toggle" title="When on, CPU mode renders the entire frame tile by tile. When off, CPU mode renders just the selected warp tile.">
                        <input type="checkbox" checked="@State.CpuFullFrameEnabled"
                               @onchange="@(e => State.CpuFullFrameEnabled = e.Value is bool b && b)"
                               disabled="@IsLocked" />
                        <span class="settings-toggle-track"><span class="settings-toggle-thumb"></span></span>
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-save" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool IsLocked { get; set; }

    private static readonly int[] fontSizes = { 8, 9, 10, 11, 12, 13, 14, 15, 16, 18, 20, 22, 24, 26, 28, 30, 32, 34, 36 };

    private Task Close() => IsOpenChanged.InvokeAsync(false);

    private static void SetInt(ChangeEventArgs e, Action<int> setter)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) setter(v);
    }

    private void SetShaderRenderMode(string value)
    {
        if (Enum.TryParse<ShaderRenderMode>(value, out var mode)) State.ShaderRenderMode = mode;
    }

    private Task PickMesh() => JS.InvokeVoidAsync("dbgPickObj").AsTask();

    private async Task OnFontSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int size))
        {
            State.EditorFontSize = size;
            await JS.InvokeVoidAsync("setMonacoFontSize", size);
        }
    }
}
