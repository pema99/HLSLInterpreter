@using HLSL
@inherits DebuggerComponent<DebuggerModel>

@{
    var debug = Slice.Debug;
    var config = Config;
    var step = debug.CurrentStep;
    var threadStates = step?.GetThreadStatesAt(debug.SelectedFrame)
        ?? Array.Empty<HLSLExecutionState.ThreadState>();
    bool onlyThreadStates = debug.DebugVertexIndex >= 0;
    bool showImage = debug.BottomMode is DebugBottomMode.PixelColors or DebugBottomMode.Both;
}
<div class="debug-section debug-section-callstack @(collapsed ? "section-collapsed" : "")">
    <div class="panel-header collapsible-header" @onclick="() => collapsed = !collapsed">
        <div class="panel-header-left">
            <span class="collapse-icon @(collapsed ? "" : "expanded")">&#x203A;</span>
            <span>Call Stack</span>
        </div>
        @if (!collapsed && threadStates.Length > 0 && debug.BottomMode == DebugBottomMode.ThreadStates)
        {
            <span class="thread-legend">
                <span class="tl-dot tc-active"></span>Active thread
                <span class="tl-dot tc-diverged"></span>Inactive thread
            </span>
        }
    </div>
    @if (!collapsed)
    {
        <div class="callstack-exec-body">
            <div class="callstack-pane">
                @if (step is { } cstep)
                {
                    var stack = cstep.CallStack;
                    <table class="var-table">
                        <tbody>
                            @for (int i = 0; i < stack.Length; i++)
                            {
                                var fi = i;
                                <tr class="@(fi == debug.SelectedFrame ? "callstack-selected" : "")"
                                    @onclick="() => Dispatch(new SelectedFrameChanged(fi))"
                                    style="cursor: pointer;">
                                    <td class="var-name">@stack[i]</td>
                                </tr>
                            }
                            <tr style="cursor: default;">
                                <td class="var-name" style="color: #555; font-style: italic;">[Globals]</td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="hint">Use Step or Continue to inspect call stack.</div>
                }
            </div>
            @if (threadStates.Length > 0 || showImage)
            {
                <div class="resize-inner-h-handle" id="callstack-exec-divider"></div>
                <div class="exec-state-pane">
                    <div class="exec-state-body" id="thread-grid-container">
                        @if (showImage)
                        {
                            <CanvasView ContainerId="image-container-debug" ModeTarget="debug" />
                        }
                        else
                        {
                            <div class="thread-grid">
                                @for (int ti = 0; ti < threadStates.Length; ti++)
                                {
                                    var tidx = ti;
                                    var state = threadStates[ti];
                                    var stateClass = state switch
                                    {
                                        HLSLExecutionState.ThreadState.Active => "tc-active",
                                        HLSLExecutionState.ThreadState.Inactive => "tc-diverged",
                                        HLSLExecutionState.ThreadState.Suspended => "tc-suspended",
                                        _ => "",
                                    };
                                    var label = $"Thread ({ti % config.WarpX}, {ti / config.WarpX}) - {state}";
                                    <div class="thread-cell @stateClass @(tidx == debug.InspectedThread ? "tc-selected" : "")"
                                         title="@label"
                                         @onclick="() => Dispatch(new InspectedThreadChanged(tidx))"></div>
                                }
                            </div>
                        }
                    </div>
                    @if (!onlyThreadStates)
                    {
                        <div class="bottom-mode-row">
                            <label>Mode</label>
                            <select value="@debug.BottomMode" @onchange="OnModeChanged">
                                <option value="@DebugBottomMode.ThreadStates">Thread states</option>
                                <option value="@DebugBottomMode.PixelColors">Pixel colors</option>
                                <option value="@DebugBottomMode.Both">Both</option>
                            </select>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="resize-v-handle" title="Drag to resize"></div>
    }
</div>

@code {
    protected override DebuggerModel Select(DebuggerModel s) => s;

    private ShaderConfig Config => Slice.Editor.ActiveDocument?.Config ?? new ShaderConfig();

    private bool collapsed;
    private (int Wx, int Wy, bool Shown) _gridState;

    private void OnModeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<DebugBottomMode>(e.Value?.ToString(), out var v))
            Dispatch(new BottomModeChanged(v));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var debug = Slice.Debug;
        var config = Config;
        bool gridShown = !collapsed
            && debug.BottomMode == DebugBottomMode.ThreadStates
            && (debug.CurrentStep?.GetThreadStatesAt(debug.SelectedFrame).Length ?? 0) > 0;
        var next = (config.WarpX, config.WarpY, gridShown);
        if (next == _gridState) return;
        _gridState = next;
        if (gridShown)
            await BrowserInterop.InitThreadGridResize("thread-grid-container", config.WarpX, config.WarpY);
        else
            await BrowserInterop.DisposeThreadGridResize();
    }

    public override void Dispose()
    {
        _ = BrowserInterop.DisposeThreadGridResize();
        base.Dispose();
    }
}
