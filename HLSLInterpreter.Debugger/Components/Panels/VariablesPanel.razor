@using HLSL
@inherits DebuggerComponent<DebugState>

<div class="debug-section debug-section-vars @(collapsed ? "section-collapsed" : "")">
    <div class="panel-header collapsible-header" @onclick="() => collapsed = !collapsed">
        <div class="panel-header-left">
            <span class="collapse-icon @(collapsed ? "" : "expanded")">&#x203A;</span>
            <span>Variables</span>
        </div>
    </div>
    @if (!collapsed)
    {
        <div class="output-body debug-vars-body">
            @if (Slice.CurrentStep is { } step)
            {
                var localFrameIdx = Math.Clamp(Slice.SelectedFrame, 0, Math.Max(0, step.FrameVariables.Length - 1));
                var locals = localFrameIdx < step.FrameVariables.Length ? step.FrameVariables[localFrameIdx] : null;
                var globals = step.GlobalVariables;

                bool hasLocals = locals != null && locals.Count > 0;
                bool hasGlobals = globals != null && globals.Count > 0;

                if (!hasLocals && !hasGlobals)
                {
                    <div class="hint">No variables in scope.</div>
                }
                else
                {
                    <div class="var-list">
                        @{
                            var rows = new List<VarRow>();
                            if (hasLocals)
                                foreach (var kvp in locals!)
                                    BuildVarRows(rows, kvp.Key, kvp.Value, 0, kvp.Key);
                            var globalRows = new List<VarRow>();
                            if (hasGlobals)
                                foreach (var kvp in globals!)
                                    BuildVarRows(globalRows, kvp.Key, kvp.Value, 0, "g:" + kvp.Key);
                        }
                        @if (hasLocals)
                        {
                            <div class="var-subsection-header" @onclick="() => localsCollapsed = !localsCollapsed">
                                <span class="collapse-icon @(localsCollapsed ? "" : "expanded")">&#x203A;</span>
                                <span>Locals</span>
                            </div>
                            if (!localsCollapsed)
                            {
                                foreach (var row in rows)
                                {
                                    var rowPath = row.Path;
                                    <div class="var-row" style="padding-left: @(6 + row.Depth * 18)px">
                                        @if (row.IsExpandable)
                                        {
                                            <span class="var-toggle @(expandedPaths.Contains(rowPath) ? "expanded" : "")"
                                                  @onclick="() => ToggleVarPath(rowPath)">&#x25BA;</span>
                                        }
                                        else
                                        {
                                            <span class="var-toggle-spacer"></span>
                                        }
                                        <span class="var-row-name" title="@row.Name">@row.Name</span>
                                        <span class="var-row-value">@HLSLValueDisplay.Format(row.Value, Slice.InspectedThread)</span>
                                    </div>
                                }
                            }
                        }
                        @if (hasGlobals)
                        {
                            <div class="var-subsection-header" @onclick="() => globalsCollapsed = !globalsCollapsed">
                                <span class="collapse-icon @(globalsCollapsed ? "" : "expanded")">&#x203A;</span>
                                <span>Globals</span>
                            </div>
                            if (!globalsCollapsed)
                            {
                                foreach (var row in globalRows)
                                {
                                    var rowPath = row.Path;
                                    <div class="var-row" style="padding-left: @(6 + row.Depth * 18)px">
                                        @if (row.IsExpandable)
                                        {
                                            <span class="var-toggle @(expandedPaths.Contains(rowPath) ? "expanded" : "")"
                                                  @onclick="() => ToggleVarPath(rowPath)">&#x25BA;</span>
                                        }
                                        else
                                        {
                                            <span class="var-toggle-spacer"></span>
                                        }
                                        <span class="var-row-name" title="@row.Name">@row.Name</span>
                                        <span class="var-row-value">@HLSLValueDisplay.Format(row.Value, Slice.InspectedThread)</span>
                                    </div>
                                }
                            }
                        }
                    </div>
                }
            }
            else
            {
                <div class="hint">Use Step or Continue to inspect variables.</div>
            }
        </div>
        <div class="resize-v-handle" title="Drag to resize"></div>
    }
</div>

@code {
    protected override DebugState Select(DebuggerModel s) => s.Debug;

    private bool collapsed;
    private bool localsCollapsed;
    private bool globalsCollapsed;
    private HashSet<string> expandedPaths = new();

    private sealed class VarRow
    {
        public string Path = "";
        public string Name = "";
        public HLSLValue Value = null!;
        public int Depth;
        public bool IsExpandable;
    }

    private void ToggleVarPath(string path)
    {
        if (!expandedPaths.Remove(path))
            expandedPaths.Add(path);
    }

    private void BuildVarRows(List<VarRow> rows, string name, HLSLValue value, int depth, string path)
    {
        if (value is ReferenceValue rv) value = rv.Get();
        bool isExpandable = value is StructValue or ArrayValue or MatrixValue;
        rows.Add(new VarRow { Path = path, Name = name, Value = value, Depth = depth, IsExpandable = isExpandable });

        if (!isExpandable || !expandedPaths.Contains(path)) return;

        if (value is StructValue sv)
        {
            foreach (var kvp in sv.Members)
                BuildVarRows(rows, kvp.Key, kvp.Value, depth + 1, $"{path}.{kvp.Key}");
        }
        else if (value is ArrayValue av)
        {
            for (int i = 0; i < av.Values.Length; i++)
                BuildVarRows(rows, $"[{i}]", av.Values[i], depth + 1, $"{path}[{i}]");
        }
        else if (value is MatrixValue mv)
        {
            for (int r = 0; r < mv.Rows; r++)
            {
                VectorValue rowVec;
                int cols = mv.Columns;
                if (mv.Values.IsVarying)
                {
                    var perThread = mv.Values.VaryingValues
                        .Select(elems => elems.Skip(r * cols).Take(cols).ToArray())
                        .ToArray();
                    rowVec = new VectorValue(mv.Type, new HLSLRegister<RawValue[]>(perThread));
                }
                else
                {
                    var rowElems = mv.Values.UniformValue.Skip(r * cols).Take(cols).ToArray();
                    rowVec = new VectorValue(mv.Type, new HLSLRegister<RawValue[]>(rowElems));
                }
                BuildVarRows(rows, $"[{r}]", rowVec, depth + 1, $"{path}[{r}]");
            }
        }
    }
}
