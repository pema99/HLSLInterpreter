@using HLSLInterpreter.Debugger.Execution
@using HLSLInterpreter.Debugger.Utils

<div class="debug-section debug-section-console @(collapsed ? "section-collapsed" : "")"
     style="@(Variant == ConsoleVariant.Run ? "--section-h: 260px;" : "")">
    <div class="panel-header collapsible-header" @onclick="() => collapsed = !collapsed">
        <div class="panel-header-left">
            <span class="collapse-icon @(collapsed ? "" : "expanded")">&#x203A;</span>
            <span>Console</span>
        </div>
    </div>
    @if (!collapsed)
    {
        <div class="output-body @(Variant == ConsoleVariant.Debug ? "debug-console-body" : "")">
            @if (HasError)
            {
                <pre class="error-text">@ErrorMessage</pre>
            }
            else if (Variant == ConsoleVariant.Debug)
            {
                @if (!string.IsNullOrEmpty(Output))
                {
                    <pre class="output-text">@Output</pre>
                }
                else
                {
                    <div class="hint">No output yet.</div>
                }
            }
            else
            {
                @if (IsGpuPreview)
                {
                    <div class="hint">Console output unavailable in GPU mode.</div>
                }
                else if (Output == null)
                {
                    <div class="hint">Press <strong>Run</strong> or <strong>Ctrl+Enter</strong> to execute.</div>
                }
                else if (Output.Length == 0)
                {
                    <div class="hint">No output.</div>
                }
                else
                {
                    <pre class="output-text">@Output</pre>
                }
            }
        </div>
        <div class="resize-v-handle" title="Drag to resize"></div>
    }
</div>

@code {
    public enum ConsoleVariant { Debug, Run }

    [Parameter] public ConsoleVariant Variant { get; set; } = ConsoleVariant.Run;
    [Parameter] public bool HasError { get; set; }
    [Parameter] public string ErrorMessage { get; set; } = "";
    [Parameter] public string Output { get; set; }
    [Parameter] public bool IsGpuPreview { get; set; }

    private bool collapsed;
}
