@inherits DebuggerComponent<EditorState>

<div class="editor-panel">
    @if (Slice.TabsEnabled)
    {
        <div class="editor-tabs panel-header-tabs">
            @{ var docs = Slice.Documents; }
            @for (int i = 0; i < docs.Count; i++)
            {
                var idx = i;
                <div class="editor-tab @(idx == Slice.ActiveIndex ? "active" : "")"
                     draggable="true"
                     @onclick="() => Dispatch(new TabSwitchRequested(idx))"
                     @ondragstart="() => _draggedTab = idx"
                     @ondragover:preventDefault="true"
                     @ondrop="(e) => OnTabDrop(e, idx)"
                     @ondragend="() => _draggedTab = -1">
                    @docs[idx].Name
                    <span class="editor-tab-close" @onclick="() => Dispatch(new TabCloseRequested(idx))" @onclick:stopPropagation>&#x2715;</span>
                </div>
            }
            <div class="editor-tabs-rest"
                 @ondragover:preventDefault="true"
                 @ondrop="OnTabDropEnd"></div>
        </div>
    }
    else
    {
        <div class="panel-header">
            <span>Code</span>
        </div>
    }
    <div id="monaco-container" class="editor-container"></div>
</div>

@code {
    [Parameter] public EventCallback OnReady { get; set; }
    [Parameter] public string InitialCode { get; set; }

    protected override EditorState Select(DebuggerModel s) => s.Editor;

    private int _draggedTab = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await EditorInterop.Init("monaco-container", Slice.ActiveDocument?.Id ?? 0, InitialCode ?? "");
        await EditorInterop.SetFontSize(Slice.FontSize);
        await OnReady.InvokeAsync();
    }

    private async Task OnTabDrop(DragEventArgs e, int targetIndex)
    {
        int from = _draggedTab;
        _draggedTab = -1;
        if (from < 0) return;
        bool after = await EditorInterop.IsTabDropAfter(targetIndex, e.ClientX);
        Dispatch(new TabMoveRequested(from, after ? targetIndex + 1 : targetIndex));
    }

    private void OnTabDropEnd()
    {
        int from = _draggedTab;
        _draggedTab = -1;
        if (from >= 0) Dispatch(new TabMoveRequested(from, Slice.Documents.Count));
    }

}
