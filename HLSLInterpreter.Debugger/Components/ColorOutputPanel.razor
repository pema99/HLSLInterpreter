@using HLSLInterpreter.Debugger.Services
@inherits StateAwareComponent

<div class="debug-section debug-section-image @(IsCollapsed ? "section-collapsed" : "")">
    <div class="panel-header collapsible-header" @onclick="ToggleCollapsed">
        <div class="panel-header-left">
            <span class="collapse-icon @(IsCollapsed ? "" : "expanded")">&#x203A;</span>
            <span>Color Output</span>
        </div>
        <div class="panel-header-actions" @onclick:stopPropagation="true">
            @if (State.ShaderRenderMode == ShaderRenderMode.VertFrag)
            {
                <div class="segmented-toggle" role="radiogroup" aria-label="Debug target">
                    <button type="button" role="radio"
                            aria-checked="@(State.DebugTarget == DebugTarget.Vertex)"
                            class="segmented-toggle-option @(State.DebugTarget == DebugTarget.Vertex ? "active" : "")"
                            @onclick="@(() => State.DebugTarget = DebugTarget.Vertex)">Vert</button>
                    <button type="button" role="radio"
                            aria-checked="@(State.DebugTarget == DebugTarget.Pixel)"
                            class="segmented-toggle-option @(State.DebugTarget == DebugTarget.Pixel ? "active" : "")"
                            @onclick="@(() => State.DebugTarget = DebugTarget.Pixel)">Frag</button>
                </div>
            }
            @if (IsGpuMode)
            {
                <button class="btn-time-ctrl" title="@(GpuPaused ? "Play" : "Pause")" @onclick="OnToggleGpuPause">
                    <i class="mdi @(GpuPaused ? "mdi-play" : "mdi-pause")"></i>
                </button>
                <button class="btn-time-ctrl" title="Restart time" @onclick="OnRestartGpuTime">
                    <i class="mdi mdi-restart"></i>
                </button>
            }
            <label class="settings-toggle panel-header-toggle" title="Use GPU">
                <input type="checkbox" checked="@State.GpuPreviewEnabled" @onchange="OnGpuToggleChanged"
                       disabled="@(IsRunning || IsDebugging)" />
                <span class="settings-toggle-track"><span class="settings-toggle-thumb"></span></span>
                <span class="panel-header-toggle-label">Use GPU</span>
            </label>
        </div>
    </div>
    @* Keep canvases mounted even when collapsed so the GPU loop's
       references stay valid across collapse/expand. *@
    <div class="image-container @(IsGpuMode ? "gpu-mode" : "")" id="image-container"
         data-mode-target="regular" style="@(IsCollapsed ? "display:none" : "")">
        <canvas class="image-canvas color-canvas-2d"></canvas>
        <canvas id="color-canvas-gpu" class="image-canvas"></canvas>
        <canvas class="image-overlay"></canvas>
    </div>
    @if (!IsCollapsed)
    {
        <div class="resize-v-handle" title="Drag to resize"></div>
    }
</div>

@code {
    [Parameter] public bool IsGpuMode { get; set; }
    [Parameter] public bool GpuPaused { get; set; }
    [Parameter] public EventCallback<bool> GpuPreviewEnabledChanged { get; set; }
    [Parameter] public bool IsRunning { get; set; }
    [Parameter] public bool IsDebugging { get; set; }
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback<bool> IsCollapsedChanged { get; set; }
    [Parameter] public EventCallback OnExpand { get; set; }
    [Parameter] public EventCallback OnToggleGpuPause { get; set; }
    [Parameter] public EventCallback OnRestartGpuTime { get; set; }

    private async Task ToggleCollapsed()
    {
        bool wasCollapsed = IsCollapsed;
        await IsCollapsedChanged.InvokeAsync(!IsCollapsed);
        if (wasCollapsed) await OnExpand.InvokeAsync();
    }

    private async Task OnGpuToggleChanged(ChangeEventArgs e)
    {
        bool v = e.Value is bool b && b;
        await GpuPreviewEnabledChanged.InvokeAsync(v);
    }
}
