@using HLSL
@using Microsoft.JSInterop
@inherits ProgramComponent<EditorState>
@inject EditorInterop Editor

<div class="editor-panel">
    @if (Slice.TabsEnabled)
    {
        <div class="editor-tabs panel-header-tabs">
            @{ var docs = Slice.Documents; }
            @for (int i = 0; i < docs.Count; i++)
            {
                var idx = i;
                <div class="editor-tab @(idx == Slice.ActiveIndex ? "active" : "")"
                     draggable="true"
                     @onclick="() => Dispatch(new TabSwitchRequested(idx))"
                     @ondragstart="() => _draggedTab = idx"
                     @ondragover:preventDefault="true"
                     @ondrop="(e) => OnTabDrop(e, idx)"
                     @ondragend="() => _draggedTab = -1">
                    @docs[idx].Name
                    <span class="editor-tab-close" @onclick="() => Dispatch(new TabCloseRequested(idx))" @onclick:stopPropagation>&#x2715;</span>
                </div>
            }
            <div class="editor-tabs-rest"
                 @ondragover:preventDefault="true"
                 @ondrop="OnTabDropEnd"></div>
        </div>
    }
    else
    {
        <div class="panel-header">
            <span>Code</span>
        </div>
    }
    <div id="monaco-container" class="editor-container"></div>
</div>

@code {
    [Parameter] public EventCallback OnReady { get; set; }

    protected override EditorState Select(AppState s) => s.Editor;

    private DotNetObjectReference<EditorPanel> _selfRef;
    private int _draggedTab = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _selfRef = DotNetObjectReference.Create(this);
        await Editor.Init("monaco-container", Slice.ActiveDocument?.Code ?? "", _selfRef);
        await Editor.SetFontSize(Slice.FontSize);
        await OnReady.InvokeAsync();
    }

    private async Task OnTabDrop(DragEventArgs e, int targetIndex)
    {
        int from = _draggedTab;
        _draggedTab = -1;
        if (from < 0) return;
        bool after = await Editor.IsTabDropAfter(targetIndex, e.ClientX);
        Dispatch(new TabMoveRequested(from, after ? targetIndex + 1 : targetIndex));
    }

    private void OnTabDropEnd()
    {
        int from = _draggedTab;
        _draggedTab = -1;
        if (from >= 0) Dispatch(new TabMoveRequested(from, Slice.Documents.Count));
    }

    [JSInvokable]
    public HoverInfo GetHoverInfo(string identifier)
    {
        var debug = Program.Model.Debug;
        if (!debug.IsActive || debug.CurrentStep is not { } step) return null;

        HLSLValue value = null;
        if (step.FrameVariables.Length > 0 && step.FrameVariables[0].TryGetValue(identifier, out var local))
            value = local;
        else if (step.GlobalVariables.TryGetValue(identifier, out var global))
            value = global;
        if (value == null) return null;

        var config = Program.Model.Editor.ActiveDocument?.Config ?? new ShaderConfig();
        int wx = Math.Max(1, config.WarpX);
        int wy = Math.Max(1, config.WarpY);
        var resolved = value is ReferenceValue rv ? rv.Get() : value;

        byte[] rgba = null;
        try { rgba = HLSLValueDisplay.RenderPreviewImage(resolved, wx, wy); }
        catch (Exception ex) { Console.WriteLine($"[hover] image render failed for '{identifier}': {ex.Message}"); }

        string[] perThread = null;
        if (debug.DebugVertexIndex >= 0)
            perThread = Enumerable.Range(0, wx * wy)
                .Select(i => HLSLValueDisplay.Format(resolved, i)).ToArray();

        return new HoverInfo
        {
            Value = HLSLValueDisplay.Format(value, debug.InspectedThread),
            Width = wx,
            Height = wy,
            Rgba = rgba,
            PerThreadValues = perThread,
            InspectedX = debug.InspectedThread % wx,
            InspectedY = debug.InspectedThread / wx,
        };
    }

    [JSInvokable]
    public void ToggleBreakpoint(int line) => Dispatch(new BreakpointToggled(line));

    public override void Dispose()
    {
        _selfRef?.Dispose();
        base.Dispose();
    }

    // Hover tooltip payload sent to JS by GetHoverInfo.
    public sealed class HoverInfo
    {
        public string Value { get; set; } = "";
        public int Width { get; set; }
        public int Height { get; set; }
        public byte[] Rgba { get; set; }
        public int InspectedX { get; set; }
        public int InspectedY { get; set; }
        public string[] PerThreadValues { get; set; }
    }
}
