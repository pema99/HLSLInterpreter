@using HLSL
@using Microsoft.JSInterop
@inherits StoreComponent<AppState>
@inject IEditorInterop Editor
@inject EditorDocumentService EditorDoc
@inject DebugSessionService DebugSession
@inject TabbedEditorOptions TabbedEditor

<div class="editor-panel">
    @if (TabbedEditor.Enabled)
    {
        <div class="editor-tabs panel-header-tabs">
            @{ var docs = Slice.Editor.Documents; }
            @for (int i = 0; i < docs.Count; i++)
            {
                var idx = i;
                <div class="editor-tab @(idx == Slice.Editor.ActiveIndex ? "active" : "")"
                     draggable="true"
                     @onclick="() => EditorDoc.SwitchToAsync(idx)"
                     @ondragstart="() => _draggedTab = idx"
                     @ondragover:preventDefault="true"
                     @ondrop="(e) => OnTabDrop(e, idx)"
                     @ondragend="() => _draggedTab = -1">
                    @docs[idx].Name
                    <span class="editor-tab-close" @onclick="() => CloseTab(idx)" @onclick:stopPropagation>&#x2715;</span>
                </div>
            }
            <div class="editor-tabs-rest"
                 @ondragover:preventDefault="true"
                 @ondrop="OnTabDropEnd"></div>
        </div>
    }
    else
    {
        <div class="panel-header">
            <span>Code</span>
        </div>
    }
    <div id="monaco-container" class="editor-container"></div>
</div>

@code {
    [Parameter] public EventCallback OnReady { get; set; }

    protected override AppState Select(AppState s) => s;

    private DotNetObjectReference<EditorPanel> _selfRef;
    private int _draggedTab = -1;

    private bool? _lastReadOnly;
    private int _lastDebugLine = -1;
    private IReadOnlySet<int> _lastBreakpoints;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await Editor.Init("monaco-container", Slice.Editor.ActiveDocument?.Code ?? "", _selfRef);
            await Editor.SetFontSize(Slice.Editor.FontSize);
            await OnReady.InvokeAsync();
        }

        var debug = Store.State.Debug;
        if (_lastReadOnly != debug.IsActive)
        {
            _lastReadOnly = debug.IsActive;
            await Editor.SetReadOnly(debug.IsActive);
        }
        int line = debug.IsActive && debug.Trace != null ? debug.Trace.LineAt(debug.StepIndex) : 0;
        if (_lastDebugLine != line)
        {
            _lastDebugLine = line;
            await Editor.HighlightLine(line);
        }
        if (!ReferenceEquals(_lastBreakpoints, debug.Breakpoints))
        {
            _lastBreakpoints = debug.Breakpoints;
            await Editor.SetBreakpoints(debug.Breakpoints.ToArray());
        }
    }

    private async Task CloseTab(int index)
    {
        var docs = Store.State.Editor.Documents;
        if (index >= 0 && index < docs.Count && Store.State.Debug.IsActive
            && docs[index].Id == Store.State.Debug.DebugDocumentId)
            DebugSession.ExitSession();
        await EditorDoc.CloseTabAsync(index);
    }

    private async Task OnTabDrop(DragEventArgs e, int targetIndex)
    {
        int from = _draggedTab;
        _draggedTab = -1;
        if (from < 0) return;
        bool after = await EditorDoc.IsTabDropAfterAsync(targetIndex, e.ClientX);
        EditorDoc.MoveTab(from, after ? targetIndex + 1 : targetIndex);
    }

    private void OnTabDropEnd()
    {
        int from = _draggedTab;
        _draggedTab = -1;
        if (from >= 0) EditorDoc.MoveTab(from, Store.State.Editor.Documents.Count);
    }

    [JSInvokable]
    public HoverInfo GetHoverInfo(string identifier)
    {
        var debug = Store.State.Debug;
        if (!debug.IsActive || debug.CurrentStep is not { } step) return null;

        HLSLValue value = null;
        if (step.FrameVariables.Length > 0 && step.FrameVariables[0].TryGetValue(identifier, out var local))
            value = local;
        else if (step.GlobalVariables.TryGetValue(identifier, out var global))
            value = global;
        if (value == null) return null;

        var config = Store.State.Editor.ActiveDocument?.Config ?? new ShaderConfig();
        int wx = Math.Max(1, config.WarpX);
        int wy = Math.Max(1, config.WarpY);
        var resolved = value is ReferenceValue rv ? rv.Get() : value;

        byte[] rgba = null;
        try { rgba = ValueImageRenderer.RenderVariableImage(resolved, wx, wy); }
        catch (Exception ex) { Console.WriteLine($"[hover] image render failed for '{identifier}': {ex.Message}"); }

        string[] perThread = null;
        if (debug.DebugVertexIndex >= 0)
            perThread = Enumerable.Range(0, wx * wy)
                .Select(i => HLSLValueFormatter.Format(resolved, i)).ToArray();

        return new HoverInfo
        {
            Value = HLSLValueFormatter.Format(value, debug.InspectedThread),
            Width = wx,
            Height = wy,
            Rgba = rgba,
            PerThreadValues = perThread,
            InspectedX = debug.InspectedThread % wx,
            InspectedY = debug.InspectedThread / wx,
        };
    }

    [JSInvokable]
    public async Task ToggleBreakpoint(int line)
    {
        Store.ToggleBreakpoint(line);
        await Editor.SetBreakpoints(Store.State.Debug.Breakpoints.ToArray());
    }

    public override void Dispose()
    {
        _selfRef?.Dispose();
        base.Dispose();
    }
}
