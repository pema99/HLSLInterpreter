@using HLSL
@using HLSLInterpreter.Debugger.Core
@implements IDisposable
@inject IJSRuntime JS
@inject FileDialogService FileDialogs
@inject TabbedEditorOptions TabbedEditorConfig
@inject DebuggerAppState State
@inject DebugController DebugCtl
@inject RunController RunCtl

<div class="editor-panel">
    @if (TabbedEditorConfig.Enabled)
    {
        <div class="editor-tabs panel-header-tabs">
            @for (int i = 0; i < tabs.Count; i++)
            {
                var idx = i;
                <div class="editor-tab @(idx == activeTabIndex ? "active" : "")"
                     draggable="true"
                     @onclick="() => SwitchTab(idx)"
                     @ondragstart="() => OnTabDragStart(idx)"
                     @ondragover="OnTabDragOver"
                     @ondragover:preventDefault="true"
                     @ondrop="(e) => OnTabDrop(e, idx)"
                     @ondragend="OnTabDragEnd">
                    @tabs[idx].Name
                    <span class="editor-tab-close" @onclick="() => CloseTab(idx)" @onclick:stopPropagation>&#x2715;</span>
                </div>
            }
            <div class="editor-tabs-rest"
                 @ondragover="OnTabDragOver"
                 @ondragover:preventDefault="true"
                 @ondrop="OnTabDropEnd"></div>
        </div>
    }
    else
    {
        <div class="panel-header">
            <span>Code</span>
        </div>
    }
    <div id="monaco-container" class="editor-container"></div>
</div>

@code {
    [Parameter] public string InitialCode { get; set; } = "";
    [Parameter] public string InitialCodeName { get; set; } = "new.hlsl";
    [Parameter] public string InitialCodePath { get; set; }
    [Parameter] public EventCallback<int> OnTabSwitched { get; set; }
    [Parameter] public EventCallback OnReady { get; set; }

    private DotNetObjectReference<EditorPanel> _selfRef;

    private sealed class EditorTab { public string Name = ""; public string Code = ""; public string Path; }
    private List<EditorTab> tabs = new();
    private int activeTabIndex;

    public int ActiveTabIndex => activeTabIndex;
    public string ActiveTabPath =>
        TabbedEditorConfig.Enabled && tabs.Count > 0 ? tabs[activeTabIndex].Path : null;
    public string ActiveTabName =>
        TabbedEditorConfig.Enabled && tabs.Count > 0 ? tabs[activeTabIndex].Name : InitialCodeName;

    public ValueTask<string> GetCode() => JS.InvokeAsync<string>("getMonacoValue");

    public async Task LoadContent(string name, string content)
    {
        if (TabbedEditorConfig.Enabled)
        {
            await OpenFileInTab(name, content);
        }
        else
        {
            await JS.InvokeVoidAsync("setMonacoValue", content);
        }
    }

    public ValueTask SetReadOnly(bool readOnly) => JS.InvokeVoidAsync("setMonacoReadOnly", readOnly);
    public ValueTask HighlightLine(int line) => JS.InvokeVoidAsync("highlightDebugLine", line);

    [JSInvokable]
    public HoverInfo GetHoverInfo(string identifier) => BuildHoverInfo(identifier);

    [JSInvokable]
    public async Task ToggleBreakpoint(int line)
    {
        DebugCtl.ToggleBreakpoint(line);
        await JS.InvokeVoidAsync("setBreakpoints", DebugCtl.Breakpoints.ToArray());
    }

    public HoverInfo BuildHoverInfo(string identifier)
    {
        if (!DebugCtl.IsDebugging || DebugCtl.CurrentSession?.Current is not { } step)
            return null;
        HLSLValue val = null;
        if (step.FrameVariables.Length > 0 && step.FrameVariables[0].TryGetValue(identifier, out var lv))
            val = lv;
        else if (step.GlobalVariables.TryGetValue(identifier, out var gv))
            val = gv;
        if (val == null) return null;

        bool vertexDebug = State.DebugVertexIndex >= 0;
        var resolved = val is ReferenceValue rv2 ? rv2.Get() : val;
        byte[] rgba = null;
        try { rgba = ValueImageRenderer.RenderVariableImage(resolved, State.WarpX, State.WarpY); }
        catch (Exception ex) { Console.WriteLine($"[hover] image render failed for '{identifier}': {ex.Message}"); }
        string[] perThread = null;
        if (vertexDebug)
        {
            int threadCount = Math.Max(1, State.WarpX * State.WarpY);
            perThread = Enumerable.Range(0, threadCount)
                .Select(i => HLSLValueFormatter.Format(resolved, i)).ToArray();
        }
        return new HoverInfo
        {
            Value = HLSLValueFormatter.Format(val, State.InspectedThread),
            Width = State.WarpX,
            Height = State.WarpY,
            Rgba = rgba,
            PerThreadValues = perThread,
            InspectedX = State.WarpX > 0 ? State.InspectedThread % State.WarpX : 0,
            InspectedY = State.WarpX > 0 ? State.InspectedThread / State.WarpX : 0,
        };
    }

    protected override void OnInitialized()
    {
        _selfRef = DotNetObjectReference.Create(this);
        if (TabbedEditorConfig.Enabled)
            tabs.Add(new EditorTab { Name = InitialCodeName, Code = InitialCode, Path = InitialCodePath });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initMonaco", "monaco-container", InitialCode, _selfRef);
            await JS.InvokeVoidAsync("setMonacoFontSize", State.EditorFontSize);
            if (TabbedEditorConfig.Enabled)
                FileDialogs.FileDropped = async (name, content, path) => await OpenFileInTab(name, content, path);
            await OnReady.InvokeAsync();
        }
    }

    public void Dispose() => _selfRef?.Dispose();

    public async Task SwitchTab(int index)
    {
        if (index == activeTabIndex) return;
        tabs[activeTabIndex].Code = await JS.InvokeAsync<string>("getMonacoValue");
        activeTabIndex = index;
        await JS.InvokeVoidAsync("setMonacoValue", tabs[activeTabIndex].Code);
        await OnTabSwitched.InvokeAsync(activeTabIndex);
    }

    private int draggedTabIndex = -1;

    private void OnTabDragStart(int index) => draggedTabIndex = index;
    private void OnTabDragEnd() => draggedTabIndex = -1;
    private void OnTabDragOver() { }

    private async Task OnTabDrop(DragEventArgs e, int targetIndex)
    {
        int from = draggedTabIndex;
        draggedTabIndex = -1;
        if (from < 0) return;

        bool dropAfter = await JS.InvokeAsync<bool>("dbgIsTabDropAfter", targetIndex, e.ClientX);
        int desired = dropAfter ? targetIndex + 1 : targetIndex;
        MoveTabTo(from, desired);
    }

    private void OnTabDropEnd()
    {
        int from = draggedTabIndex;
        draggedTabIndex = -1;
        if (from < 0) return;
        MoveTabTo(from, tabs.Count);
    }

    private void MoveTabTo(int from, int desired)
    {
        if (desired == from || desired == from + 1) return;
        var active = tabs[activeTabIndex];
        var moving = tabs[from];
        tabs.RemoveAt(from);
        int insertAt = desired > from ? desired - 1 : desired;
        tabs.Insert(insertAt, moving);
        activeTabIndex = tabs.IndexOf(active);
        StateHasChanged();
    }

    private async Task CloseTab(int index)
    {
        if (tabs.Count <= 1) return;
        if (index == activeTabIndex)
        {
            int newActive = index > 0 ? index - 1 : 1;
            activeTabIndex = newActive;
            await JS.InvokeVoidAsync("setMonacoValue", tabs[newActive].Code);
        }
        tabs.RemoveAt(index);
        if (activeTabIndex > index) activeTabIndex--;
    }

    public async Task OpenFileDialog()
    {
        var (path, content) = await FileDialogs.OpenFile();
        if (path == null || content == null) return;
        var existing = tabs.FindIndex(t => t.Path == path);
        if (existing >= 0) { await SwitchTab(existing); return; }
        tabs[activeTabIndex].Code = await JS.InvokeAsync<string>("getMonacoValue");
        string name = System.IO.Path.GetFileName(path);
        tabs.Add(new EditorTab { Name = name, Code = content, Path = path });
        activeTabIndex = tabs.Count - 1;
        await JS.InvokeVoidAsync("setMonacoValue", content);
        StateHasChanged();
    }

    public async Task SaveFileDialog()
    {
        string code = await JS.InvokeAsync<string>("getMonacoValue");
        string savedPath = await FileDialogs.SaveFile(code, tabs[activeTabIndex].Path);
        if (savedPath == null) return;
        tabs[activeTabIndex].Path = savedPath;
        tabs[activeTabIndex].Name = System.IO.Path.GetFileName(savedPath);
        tabs[activeTabIndex].Code = code;
        StateHasChanged();
    }

    public async Task SaveFileAsDialog()
    {
        string code = await JS.InvokeAsync<string>("getMonacoValue");
        string savedPath = await FileDialogs.SaveFileAs(code);
        if (savedPath == null) return;
        tabs[activeTabIndex].Path = savedPath;
        tabs[activeTabIndex].Name = System.IO.Path.GetFileName(savedPath);
        tabs[activeTabIndex].Code = code;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OpenFileInTab(string name, string content, string path = null)
    {
        if (!TabbedEditorConfig.Enabled) return;
        var existing = tabs.FindIndex(t => t.Name == name);
        if (existing >= 0)
        {
            await SwitchTab(existing);
        }
        else
        {
            tabs[activeTabIndex].Code = await JS.InvokeAsync<string>("getMonacoValue");
            tabs.Add(new EditorTab { Name = name, Code = content, Path = string.IsNullOrEmpty(path) ? null : path });
            activeTabIndex = tabs.Count - 1;
            await JS.InvokeVoidAsync("setMonacoValue", content);
        }
        StateHasChanged();
    }
}
