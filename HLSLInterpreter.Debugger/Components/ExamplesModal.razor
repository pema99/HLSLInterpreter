@inherits StateAwareComponent
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">Example shaders</div>
            <div class="modal-body example-list">
                @if (_examples == null)
                {
                    <div class="example-loading">Loading...</div>
                }
                else if (_examples.Count == 0)
                {
                    <div class="example-loading">No examples found.</div>
                }
                else
                {
                    @foreach (var ex in _examples)
                    {
                        <button class="example-item" @onclick="@(() => Pick(ex))">
                            <span class="example-name">@ex.Name</span>
                        </button>
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="btn-modal-save" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<(string Name, string Content)> OnSelected { get; set; }

    private const string BaseUrl = "_content/HLSLInterpreter.Debugger/ExampleShaders/";

    private sealed class Example
    {
        public string File;
        public string Name;
        public string Cleaned;
        public ShaderRenderMode? Mode;
        public string FragEntry;
        public string VertEntry;
    }

    private List<Example> _examples;
    private bool _wasOpen;

    private Task Close() => IsOpenChanged.InvokeAsync(false);

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen && _examples == null)
            await LoadAsync();
        _wasOpen = IsOpen;
    }

    private async Task LoadAsync()
    {
        var entries = new List<Example>();
        try
        {
            string indexText = await JS.InvokeAsync<string>("dbgFetchText", BaseUrl + "index.txt");
            var files = indexText.Replace("\r", "").Split('\n')
                .Select(s => s.Trim()).Where(s => s.Length > 0);

            foreach (var file in files)
            {
                try
                {
                    string raw = await JS.InvokeAsync<string>("dbgFetchText", BaseUrl + file);
                    var ex = ParseHeader(raw);
                    ex.File = file;
                    if (string.IsNullOrWhiteSpace(ex.Name)) ex.Name = file;
                    entries.Add(ex);
                }
                catch (Exception e) { Console.WriteLine($"[examples] {file}: {e.Message}"); }
            }
            entries.Sort((a, b) => StringComparer.OrdinalIgnoreCase.Compare(a.Name, b.Name));
        }
        catch (Exception e) { Console.WriteLine("[examples] index: " + e.Message); }

        _examples = entries;
        StateHasChanged();
    }

    private async Task Pick(Example ex)
    {
        if (ex.Mode.HasValue) State.ShaderRenderMode = ex.Mode.Value;
        if (!string.IsNullOrWhiteSpace(ex.FragEntry)) State.FragmentEntryPoint = ex.FragEntry;
        if (!string.IsNullOrWhiteSpace(ex.VertEntry)) State.VertexEntryPoint = ex.VertEntry;
        await IsOpenChanged.InvokeAsync(false);
        await OnSelected.InvokeAsync((ex.Name, ex.Cleaned));
    }

    private static Example ParseHeader(string content)
    {
        var lines = content.Replace("\r\n", "\n").Split('\n');
        int consumed = 0;
        var ex = new Example();

        foreach (var line in lines)
        {
            var trimmed = line.TrimStart();
            if (!trimmed.StartsWith("//")) break;

            var directive = trimmed.Substring(2).Trim();
            int colon = directive.IndexOf(':');
            if (colon < 0) break;

            var key = directive.Substring(0, colon).Trim();
            var value = directive.Substring(colon + 1).Trim();

            bool recognized = true;
            if (key.Equals("Name", StringComparison.OrdinalIgnoreCase)) ex.Name = value;
            else if (key.Equals("RenderMode", StringComparison.OrdinalIgnoreCase))
            {
                if (Enum.TryParse<ShaderRenderMode>(value, true, out var m)) ex.Mode = m;
            }
            else if (key.Equals("FragEntry", StringComparison.OrdinalIgnoreCase)) ex.FragEntry = value;
            else if (key.Equals("VertEntry", StringComparison.OrdinalIgnoreCase)) ex.VertEntry = value;
            else recognized = false;

            if (!recognized) break;
            consumed++;
        }

        ex.Cleaned = string.Join("\n", lines.Skip(consumed)).TrimStart('\n');
        return ex;
    }
}
