@using HLSLInterpreter.Debugger.Execution
@using HLSLInterpreter.Debugger.Utils
@using HLSLInterpreter.Debugger.Services
@inject ImageLibraryService Library

@if (IsOpen)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-dialog" @onclick:stopPropagation="true" style="max-width: 560px; width: 90vw; max-height: 85vh;">
            <div class="modal-header">Pick an image</div>
            <div class="modal-body" style="overflow-y: auto; min-height: 0;">
                @if (Library.Examples.Count == 0 && Library.RecentUploads.Count == 0)
                {
                    <div class="tex-empty">Loading…</div>
                }
                else
                {
                    <div class="lib-grid">
                        @foreach (var img in Library.RecentUploads.Concat(Library.Examples))
                        {
                            <button class="lib-tile" @onclick="@(() => Pick(img))" title="@img.FileName" disabled="@string.IsNullOrEmpty(img.PreviewDataUrl)">
                                <img src="@img.PreviewDataUrl" alt="@img.FileName" />
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-modal-save" @onclick="Close">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<TextureBinding> OnPicked { get; set; }

    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_loaded)
        {
            _loaded = true;
            await Library.EnsureExamplesLoadingAsync();
            StateHasChanged();
        }
    }

    private Task Close() => IsOpenChanged.InvokeAsync(false);

    private async Task Pick(TextureBinding img)
    {
        await Library.EnsureBytesAsync(img);
        await OnPicked.InvokeAsync(img);
        await IsOpenChanged.InvokeAsync(false);
    }
}
