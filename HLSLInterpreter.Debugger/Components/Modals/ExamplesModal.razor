@inject DebuggerProgram Program
@inject ImageLibraryService Library

<div class="modal-overlay" @onclick="Close">
    <div class="modal-dialog" @onclick:stopPropagation="true" style="max-width: 480px; width: 90vw;">
        <div class="modal-header">Example shaders</div>
        <div class="modal-body example-list">
            @if (_examples == null)
            {
                <div class="example-loading">Loading...</div>
            }
            else if (_examples.Count == 0)
            {
                <div class="example-loading">No examples found.</div>
            }
            else
            {
                @foreach (var ex in _examples)
                {
                    <button class="example-item" @onclick="@(() => Pick(ex))">
                        <span class="example-name">@ex.Name</span>
                        <span class="example-mode">@FormatMode(ex.Mode)</span>
                    </button>
                }
            }
        </div>
        <div class="modal-footer">
            <button class="btn-modal-save" @onclick="Close">Close</button>
        </div>
    </div>
</div>

@code {
    private const string BaseUrl = "_content/HLSLInterpreter.Debugger/ExampleShaders/";

    private sealed class Example
    {
        public string File;
        public string Name;
        public string Cleaned;
        public ShaderRenderMode? Mode;
        public string FragEntry;
        public string VertEntry;
        public List<(string UniformName, string FileName)> Textures = new();
    }

    private List<Example> _examples;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void Close() => Program.Dispatch(new ModalDismissed());

    private static string FormatMode(ShaderRenderMode? mode) => mode switch
    {
        ShaderRenderMode.VertFrag => "Vertex+Fragment",
        ShaderRenderMode.Pixel => "Fragment",
        _ => "",
    };

    private static int ModeOrder(ShaderRenderMode? mode) => mode switch
    {
        ShaderRenderMode.Pixel => 0,
        ShaderRenderMode.VertFrag => 1,
        _ => 2,
    };

    private async Task LoadAsync()
    {
        var entries = new List<Example>();
        try
        {
            string indexText = await BrowserInterop.FetchText(BaseUrl + "index.txt");
            var files = indexText.Replace("\r", "").Split('\n')
                .Select(s => s.Trim()).Where(s => s.Length > 0);

            foreach (var file in files)
            {
                try
                {
                    string raw = await BrowserInterop.FetchText(BaseUrl + file);
                    var ex = ParseHeader(raw);
                    ex.File = file;
                    if (string.IsNullOrWhiteSpace(ex.Name)) ex.Name = file;
                    entries.Add(ex);
                }
                catch (Exception e) { Console.WriteLine($"[examples] {file}: {e.Message}"); }
            }
            entries.Sort((a, b) =>
            {
                int byMode = ModeOrder(a.Mode).CompareTo(ModeOrder(b.Mode));
                return byMode != 0 ? byMode : StringComparer.OrdinalIgnoreCase.Compare(a.Name, b.Name);
            });
        }
        catch (Exception e) { Console.WriteLine("[examples] index: " + e.Message); }

        _examples = entries;
        StateHasChanged();
    }

    private async Task Pick(Example ex)
    {
        var newTextures = new List<TextureBinding>();
        if (ex.Textures.Count > 0)
        {
            await Library.EnsureExamplesLoadingAsync();
            foreach (var (uniformName, fileName) in ex.Textures)
            {
                var src = Library.Examples.FirstOrDefault(t => t.FileName == fileName);
                if (src == null) continue;
                await Library.EnsureBytesAsync(src);
                if (src.Rgba8 == null) continue;
                newTextures.Add(new TextureBinding
                {
                    Name = uniformName,
                    FileName = src.FileName,
                    Rgba8 = src.Rgba8,
                    Width = src.Width,
                    Height = src.Height,
                    PreviewDataUrl = src.PreviewDataUrl,
                });
            }
        }
        Program.Dispatch(new DocumentLoaded(
            ex.Name, ex.Cleaned, ex.Mode, ex.FragEntry, ex.VertEntry, newTextures, new List<SamplerBinding>(), Run: true));
    }

    private static Example ParseHeader(string content)
    {
        var lines = content.Replace("\r\n", "\n").Split('\n');
        int consumed = 0;
        var ex = new Example();

        foreach (var line in lines)
        {
            var trimmed = line.TrimStart();
            if (!trimmed.StartsWith("//")) break;

            var directive = trimmed.Substring(2).Trim();
            int colon = directive.IndexOf(':');
            if (colon < 0) break;

            var key = directive.Substring(0, colon).Trim();
            var value = directive.Substring(colon + 1).Trim();

            bool recognized = true;
            if (key.Equals("Name", StringComparison.OrdinalIgnoreCase)) ex.Name = value;
            else if (key.Equals("RenderMode", StringComparison.OrdinalIgnoreCase))
            {
                if (Enum.TryParse<ShaderRenderMode>(value, true, out var m)) ex.Mode = m;
            }
            else if (key.Equals("FragEntry", StringComparison.OrdinalIgnoreCase)) ex.FragEntry = value;
            else if (key.Equals("VertEntry", StringComparison.OrdinalIgnoreCase)) ex.VertEntry = value;
            else if (key.Equals("Texture", StringComparison.OrdinalIgnoreCase))
            {
                var parts = value.Split((char[])null, StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length >= 2) ex.Textures.Add((parts[0], parts[1]));
            }
            else recognized = false;

            if (!recognized) break;
            consumed++;
        }

        ex.Cleaned = string.Join("\n", lines.Skip(consumed)).TrimStart('\n');
        return ex;
    }
}
