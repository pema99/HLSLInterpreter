<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HLSLInterpreter\HLSLInterpreter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="wwwroot\lib\HLSLTest.hlsl" Visible="false" />
  </ItemGroup>

  <!-- gpu.js fetches HLSLTest.hlsl and prepends it to the user shader. -->
  <Target Name="CopyHLSLTestPreamble" BeforeTargets="ResolveStaticWebAssetsInputs;BeforeBuild">
    <Copy SourceFiles="..\HLSLInterpreter\HLSLTest.hlsl" DestinationFiles="wwwroot\lib\HLSLTest.hlsl" SkipUnchangedFiles="true" />
  </Target>

  <!-- ExamplesModal fetches index.txt to enumerate available examples. -->
  <Target Name="GenerateExampleShadersIndex" BeforeTargets="ResolveStaticWebAssetsInputs;BeforeBuild">
    <ItemGroup>
      <_ExampleShader Include="wwwroot\ExampleShaders\*.hlsl" />
    </ItemGroup>
    <WriteLinesToFile File="wwwroot\ExampleShaders\index.txt" Lines="@(_ExampleShader -> '%(Filename)%(Extension)')" Overwrite="true" />
  </Target>

  <!-- LibraryPickerModal fetches index.txt to enumerate available example textures. -->
  <Target Name="GenerateExampleTexturesIndex" BeforeTargets="ResolveStaticWebAssetsInputs;BeforeBuild">
    <ItemGroup>
      <_ExampleTexture Include="wwwroot\ExampleTextures\*.png;wwwroot\ExampleTextures\*.jpg;wwwroot\ExampleTextures\*.jpeg" />
    </ItemGroup>
    <WriteLinesToFile File="wwwroot\ExampleTextures\index.txt" Lines="@(_ExampleTexture -> '%(Filename)%(Extension)')" Overwrite="true" />
  </Target>

</Project>
