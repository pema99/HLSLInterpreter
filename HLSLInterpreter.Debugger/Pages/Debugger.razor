@page "/"
@inherits StoreComponent<AppState>
@implements IDisposable
@inject ShaderRunService Run
@inject DebugSessionService DebugSession
@inject EditorDocumentService EditorDoc
@inject PermalinkService Permalink
@inject JsProjectionService Projection
@inject IBrowserInterop Browser
@inject NavigationManager Nav
@inject InitialCodeOptions InitialCode
@inject PermalinkOptions PermalinkBase
@inject TabbedEditorOptions TabbedEditor
@using Microsoft.JSInterop

@{
    var ui = Slice.Ui;
    var run = Slice.Run;
    var debug = Slice.Debug;
    bool debugging = debug.IsActive;
    bool running = run.Status != RunStatus.Idle;
    bool cancellable = run.Status == RunStatus.Cancellable;
    int stepCount = debug.Trace?.Steps.Count ?? 0;
    bool canFwd = debug.Trace != null && debug.StepIndex < stepCount - 1;
    bool canBack = debug.Trace != null && debug.StepIndex > 0;
}
<div class="app-shell @(ui.BonzomaticMode && !debugging ? "bonzomatic" : "")">
    <header class="topbar">
        <div class="topbar-left">
            <div class="menu-button-wrap">
                <button class="btn-menu" @onclick="@(() => Store.SetMenuOpen(!ui.MenuOpen))" title="Menu"><i class="mdi mdi-menu"></i></button>
                @if (ui.MenuOpen)
                {
                    <div class="menu-backdrop" @onclick="@(() => Store.SetMenuOpen(false))"></div>
                    <div class="menu-dropdown">
                        @if (TabbedEditor.Enabled)
                        {
                            <button class="menu-item" @onclick="@(() => OpenModal(ModalKind.NewFile))">New file</button>
                            <button class="menu-item" @onclick="MenuOpenFile">Open file</button>
                            <button class="menu-item" @onclick="MenuSaveFileAs">Save as</button>
                            <button class="menu-item" @onclick="MenuSaveFile">Save</button>
                            <div class="menu-divider"></div>
                        }
                        <button class="menu-item" @onclick="@(() => OpenModal(ModalKind.Examples))">Example shaders</button>
                        <button class="menu-item" @onclick="@(() => OpenModal(ModalKind.ShaderToyImport))">Import ShaderToy</button>
                        <button class="menu-item menu-item-toggle" @onclick="ToggleBonzomatic">
                            <span>Bonzomatic mode</span>
                            <span class="menu-item-check">@(ui.BonzomaticMode ? "✓" : "")</span>
                        </button>
                        <div class="menu-divider"></div>
                        <button class="menu-item" @onclick="MenuCopyPermalink">Copy permalink</button>
                        <button class="menu-item" @onclick="MenuDownload">Download current file</button>
                        <div class="menu-divider"></div>
                        <button class="menu-item" @onclick="@(() => OpenModal(ModalKind.Hotkeys))">Hotkeys</button>
                        <button class="menu-item" @onclick="@(() => OpenModal(ModalKind.Textures))">Textures</button>
                        <button class="menu-item" @onclick="@(() => OpenModal(ModalKind.Settings))">Settings</button>
                    </div>
                }
            </div>
            <a class="topbar-title" href="https://github.com/pema99/HLSLInterpreter" target="_blank" rel="noopener noreferrer" title="View on GitHub">HLSLInterpreter</a>
        </div>

        <div class="topbar-center">
            @if (debugging)
            {
                <div class="debug-controls">
                    <button class="btn-dbg btn-dbg-continue" data-dbg="continue" @onclick="@(() => Step(Store.ContinueToBreakpoint))" disabled="@(!canFwd)" title="Continue (F5)"><i class="mdi mdi-play-outline"></i></button>
                    <button class="btn-dbg" data-dbg="step-over" @onclick="@(() => Step(Store.StepOver))" disabled="@(!canFwd)" title="Step over (F10)"><i class="mdi mdi-debug-step-over"></i></button>
                    <button class="btn-dbg" data-dbg="step-in" @onclick="@(() => Step(Store.StepForward))" disabled="@(!canFwd)" title="Step in (F11)"><i class="mdi mdi-debug-step-into icon-step-into"></i></button>
                    <button class="btn-dbg" data-dbg="step-out" @onclick="@(() => Step(Store.StepOut))" disabled="@(!canFwd)" title="Step out (F12)"><i class="mdi mdi-debug-step-out icon-step-out"></i></button>
                    <div class="dbg-controls-sep"></div>
                    <button class="btn-dbg btn-dbg-continue-back" data-dbg="continue-back" @onclick="@(() => Step(Store.ContinueToBreakpointBack))" disabled="@(!canBack)" title="Continue back (Shift+F5)"><i class="mdi mdi-play-outline btn-icon-mirror"></i></button>
                    <button class="btn-dbg" data-dbg="step-over-back" @onclick="@(() => Step(Store.StepOverBack))" disabled="@(!canBack)" title="Step over back (Shift+F10)"><i class="mdi mdi-debug-step-over btn-icon-mirror"></i></button>
                    <button class="btn-dbg" data-dbg="step-in-back" @onclick="@(() => Step(Store.StepBack))" disabled="@(!canBack)" title="Step in back (Shift+F11)"><i class="mdi mdi-debug-step-into icon-step-into-back"></i></button>
                    <button class="btn-dbg" data-dbg="step-out-back" @onclick="@(() => Step(Store.StepOutBack))" disabled="@(!canBack)" title="Step out back (Shift+F12)"><i class="mdi mdi-debug-step-out icon-step-out-back"></i></button>
                </div>
            }
        </div>

        <div class="topbar-right">
            <div class="share-button-wrap">
                <button class="btn-share" @onclick="MenuCopyPermalink" title="Copy permalink to clipboard"><i class="mdi mdi-share-variant"></i></button>
                @if (permalinkCopied)
                {
                    <span class="permalink-toast" @key="permalinkToastKey">Permalink copied to clipboard</span>
                }
            </div>
            <button class="btn-run" @onclick="RunOrCancel"
                    disabled="@((running && !cancellable) || debugging)"
                    title="@(cancellable ? "Stop" : "Run")">
                @if (running)
                {
                    <span class="spinner"></span>
                }
                else
                {
                    <i class="mdi mdi-play"></i>
                }
            </button>
            @if (debugging)
            {
                <button class="btn-stop" @onclick="ExitDebug" title="Stop debugging"><i class="mdi mdi-stop"></i></button>
            }
            else
            {
                <button class="btn-debug-start" @onclick="StartDebug" disabled="@running" title="Debug (record execution trace)"><i class="mdi mdi-bug-outline"></i></button>
            }
        </div>
    </header>

    <div class="main-split">
        <EditorPanel OnReady="OnEditorReady" />

        <div class="resize-h-handle" title="Drag to resize"></div>

        <div class="output-panel">
            @if (debugging)
            {
                <VariablesPanel />
                <CallStackPanel />
                <ImmediatePanel />
                <ConsolePanel Variant="ConsolePanel.ConsoleVariant.Debug"
                              HasError="@(run.Error != null)" ErrorMessage="@(run.Error?.Message ?? "")"
                              Output="@(debug.Trace?.OutputThrough(debug.StepIndex) ?? "")" />
                <div class="debug-panel-spacer"></div>
            }
            else
            {
                <ColorOutputPanel />
                <ConsolePanel Variant="ConsolePanel.ConsoleVariant.Run"
                              HasError="@(run.Error != null)" ErrorMessage="@(run.Error?.Message ?? "")"
                              Output="@run.Output" IsGpuPreview="@run.GpuPreviewEnabled" />
                <div class="debug-panel-spacer"></div>
            }
        </div>
    </div>
</div>

@if (ui.OpenModal == ModalKind.Settings) { <SettingsModal /> }
@if (ui.OpenModal == ModalKind.Hotkeys) { <HotkeysModal /> }
@if (ui.OpenModal == ModalKind.Textures) { <TexturesModal /> }
@if (ui.OpenModal == ModalKind.Examples) { <ExamplesModal /> }
@if (ui.OpenModal == ModalKind.ShaderToyImport) { <ShaderToyImportModal /> }
@if (ui.OpenModal == ModalKind.NewFile) { <NewFileModal /> }

@code {
    protected override AppState Select(AppState s) => s;

    private DotNetObjectReference<Debugger> _dotNetRef;
    private string _pendingShaderToy;
    private bool permalinkCopied;
    private int permalinkToastKey;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _dotNetRef = DotNetObjectReference.Create(this);

        string code = InitialCode.Code ?? DefaultShader.Code;
        var codeParam = PermalinkCodec.GetQueryParam(Nav.Uri, "c");
        if (!string.IsNullOrEmpty(codeParam))
        {
            try { code = PermalinkCodec.DecompressCode(codeParam); }
            catch { }
        }
        var shaderToyParam = PermalinkCodec.GetQueryParam(Nav.Uri, "shadertoy");
        if (!string.IsNullOrEmpty(shaderToyParam))
        {
            try { _pendingShaderToy = PermalinkCodec.DecompressCode(shaderToyParam); }
            catch (Exception ex) { Console.WriteLine("[shadertoy-url] decode failed: " + ex.Message); }
        }

        var document = EditorDoc.NewDocument(InitialCode.Name ?? "new.hlsl", code, InitialCode.Path);
        Store.SetDocuments(new[] { document }, 0);
        Permalink.ApplyUrlToStore(Nav.Uri);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            string objText = await Browser.FetchText("_content/HLSLInterpreter.Debugger/lib/monkey.obj");
            Store.SetMesh(Mesh.ParseObj(objText));
        }
        catch (Exception ex) { Console.WriteLine("[default-mesh] " + ex.Message); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Browser.SetDebuggerRef(_dotNetRef);
            Run.DotNetRef = _dotNetRef;
            Projection.Start();
            await Projection.ProjectAsync();
        }
    }

    private async Task OnEditorReady()
    {
        if (_pendingShaderToy != null)
        {
            string glsl = _pendingShaderToy;
            _pendingShaderToy = null;
            try
            {
                string hlsl = await Browser.TranspileGlsl(glsl);
                await EditorDoc.LoadContentAsync("shadertoy.hlsl", hlsl);
                Store.SetRenderMode(ShaderRenderMode.Pixel);
                Store.SetFragmentEntryPoint("frag");
            }
            catch (Exception ex) { Console.WriteLine("[shadertoy-url] " + ex.Message); }
        }
        await DoRun();
    }

    private Task RunOrCancel()
    {
        if (Slice.Run.Status == RunStatus.Cancellable)
        {
            Run.RequestCancel();
            return Task.CompletedTask;
        }
        return DoRun();
    }

    private async Task DoRun()
    {
        Store.SetImageCollapsed(false);
        await Run.RunAsync(await EditorDoc.GetActiveCodeAsync());
    }

    private async Task StartDebug()
    {
        var config = Slice.Editor.ActiveDocument?.Config ?? new ShaderConfig();
        if (config.RenderMode == ShaderRenderMode.VertFrag
            && config.DebugTarget == DebugTarget.Vertex
            && Slice.Debug.DebugVertexIndex < 0)
        {
            await StartDebugAtVertex(0, Slice.Run.GpuCaptured?.Time ?? 0f,
                Slice.Run.GpuCaptured?.CanvasW ?? Math.Max(1, config.WarpX),
                Slice.Run.GpuCaptured?.CanvasH ?? Math.Max(1, config.WarpY));
            return;
        }
        var document = Slice.Editor.ActiveDocument;
        if (document == null) return;
        string code = await EditorDoc.GetActiveCodeAsync();
        await DebugSession.StartSessionAsync(code, document.Id);
    }

    private async Task ExitDebug()
    {
        DebugSession.ExitSession();
        await DoRun();
    }

    private async Task Step(Action navigate)
    {
        await EnsureDebugDocumentActive();
        navigate();
    }

    private async Task EnsureDebugDocumentActive()
    {
        int debugId = Slice.Debug.DebugDocumentId;
        if (debugId < 0 || Slice.Editor.ActiveDocument?.Id == debugId) return;
        var documents = Slice.Editor.Documents;
        for (int i = 0; i < documents.Count; i++)
        {
            if (documents[i].Id == debugId)
            {
                await EditorDoc.SwitchToAsync(i);
                return;
            }
        }
    }

    [JSInvokable]
    public async Task LoadObjMesh(string objText)
    {
        if (string.IsNullOrWhiteSpace(objText)) return;
        try { Store.SetMesh(Mesh.ParseObj(objText)); }
        catch (Exception ex)
        {
            Store.SetRunError("Failed to load OBJ: " + ex.Message, ex);
            return;
        }
        await DoRun();
    }

    [JSInvokable]
    public void SetInspectedPixel(int px, int py)
    {
        var config = Slice.Editor.ActiveDocument?.Config ?? new ShaderConfig();
        if (config.WarpX <= 0) return;
        Store.SetInspectedThread(py * config.WarpX + px);
    }

    [JSInvokable]
    public async Task StartDebugAtPixel(int px, int py, float time, int canvasW, int canvasH)
    {
        var config = Slice.Editor.ActiveDocument?.Config ?? new ShaderConfig();
        int wx = Math.Max(1, config.WarpX);
        int wy = Math.Max(1, config.WarpY);
        DebugSession.SaveGroupOffsetsForRestore();
        Store.SetGroupOffset(px / wx, py / wy);
        Store.SetInspectedThread((py % wy) * wx + (px % wx));
        Store.SetGpuCaptured(new GpuCapture(time, canvasW, canvasH));
        await StartDebug();
    }

    [JSInvokable]
    public async Task StartDebugAtVertex(int vertexIndex, float time, int canvasW, int canvasH)
    {
        var config = Slice.Editor.ActiveDocument?.Config ?? new ShaderConfig();
        int warpSize = Math.Max(1, config.WarpX * config.WarpY);
        Store.SetInspectedThread(vertexIndex % warpSize);
        Store.SetDebugVertexIndex(vertexIndex);
        Store.SetGpuCaptured(new GpuCapture(time, canvasW, canvasH));
        if (Slice.Debug.BottomMode != DebugBottomMode.ThreadStates)
            Store.SetBottomMode(DebugBottomMode.ThreadStates);
        await StartDebug();
    }

    private void OpenModal(ModalKind kind)
    {
        Store.SetMenuOpen(false);
        Store.OpenModal(kind);
    }

    private async Task MenuOpenFile()
    {
        Store.SetMenuOpen(false);
        await EditorDoc.OpenFileDialogAsync();
    }

    private async Task MenuSaveFile()
    {
        Store.SetMenuOpen(false);
        await EditorDoc.SaveFileAsync();
    }

    private async Task MenuSaveFileAs()
    {
        Store.SetMenuOpen(false);
        await EditorDoc.SaveFileAsAsync();
    }

    private async Task MenuDownload()
    {
        Store.SetMenuOpen(false);
        string code = await EditorDoc.GetActiveCodeAsync();
        var document = Slice.Editor.ActiveDocument;
        string fileName = string.IsNullOrWhiteSpace(document?.Name) ? "shader.hlsl" : document.Name;
        await Browser.DownloadTextFile(fileName, code);
    }

    private async Task ToggleBonzomatic()
    {
        Store.SetMenuOpen(false);
        if (Slice.Debug.IsActive) DebugSession.ExitSession();
        bool enabled = !Slice.Ui.BonzomaticMode;
        Store.SetBonzomaticMode(enabled);
        if (enabled && !Slice.Run.GpuPreviewEnabled)
        {
            Store.SetGpuPreviewEnabled(true);
            await DoRun();
        }
    }

    private async Task MenuCopyPermalink()
    {
        Store.SetMenuOpen(false);
        string code = await EditorDoc.GetActiveCodeAsync();
        string baseUrl = PermalinkBase.Url ?? new Uri(Nav.Uri).GetLeftPart(UriPartial.Path);
        await Permalink.CopyAsync(code, baseUrl);

        int key = ++permalinkToastKey;
        permalinkCopied = true;
        StateHasChanged();
        await Task.Delay(1500);
        if (permalinkToastKey == key)
        {
            permalinkCopied = false;
            StateHasChanged();
        }
    }

    public override void Dispose()
    {
        _dotNetRef?.Dispose();
        base.Dispose();
    }
}
