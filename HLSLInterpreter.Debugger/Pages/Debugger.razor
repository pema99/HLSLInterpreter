@page "/"
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject PermalinkOptions PermalinkBase
@inject InitialCodeOptions InitialCode
@inject DebuggerAppState State
@inject RunController RunCtl
@inject DebugController DebugCtl
@inject TabbedEditorOptions TabbedEditorConfig
@using HLSL
@using UnityShaderParser.HLSL
@using HLSLInterpreter.Debugger.Core
@* Razor's generated cast for `@ref` on EditorPanel writes the bare path
   `HLSLInterpreter.Debugger.Components.EditorPanel`. With `@using HLSL`
   in scope, `HLSLInterpreter` resolves to the parser's class instead of
   the namespace. This alias forces the namespace lookup. *@
@using HLSLInterpreter = global::HLSLInterpreter
@implements IAsyncDisposable

<div class="app-shell">
    <header class="topbar">
        <div class="topbar-left">
            <div class="menu-button-wrap">
                <button class="btn-menu" @onclick="@(() => menuOpen = !menuOpen)" title="Menu"><i class="mdi mdi-menu"></i></button>
                @if (menuOpen)
                {
                    <div class="menu-backdrop" @onclick="@(() => menuOpen = false)"></div>
                    <div class="menu-dropdown">
                        @if (TabbedEditorConfig.Enabled)
                        {
                            <button class="menu-item" @onclick="MenuNewFile">New file</button>
                            <button class="menu-item" @onclick="MenuOpenFile">Open file</button>
                            <button class="menu-item" @onclick="MenuSaveFileAs">Save as</button>
                            <button class="menu-item" @onclick="MenuSaveFile">Save</button>
                            <div class="menu-divider"></div>
                        }
                        <button class="menu-item" @onclick="MenuOpenExamples">Example shaders</button>
                        <a class="menu-item" href="https://github.com/pema99/HLSLInterpreter" target="_blank" rel="noopener noreferrer" @onclick="@(() => menuOpen = false)">View GitHub repo</a>
                        <div class="menu-divider"></div>
                        <button class="menu-item" @onclick="MenuCopyPermalink">Copy permalink</button>
                        <button class="menu-item" @onclick="MenuDownloadCurrentFile">Download current file</button>
                        <div class="menu-divider"></div>
                        <button class="menu-item" @onclick="MenuOpenSettings">Settings</button>
                    </div>
                }
            </div>
            <span class="topbar-title">HLSLInterpreter</span>
        </div>

        <div class="topbar-center">
            @if (DebugCtl.IsDebugging)
            {
                <div class="debug-controls">
                    <button class="btn-dbg btn-dbg-continue" data-dbg="continue" @onclick="ContinueToBreakpoint" disabled="@(DebugCtl.CurrentSession is null || DebugCtl.CurrentSession.StepIndex >= DebugCtl.CurrentSession.Trace.Count - 1)" title="Continue (F5)"><i class="mdi mdi-play-outline"></i></button>
                    <button class="btn-dbg" data-dbg="step-over" @onclick="StepOver" disabled="@(DebugCtl.CurrentSession is null || DebugCtl.CurrentSession.StepIndex >= DebugCtl.CurrentSession.Trace.Count - 1)" title="Step over (F10)"><i class="mdi mdi-debug-step-over"></i></button>
                    <button class="btn-dbg" data-dbg="step-in" @onclick="StepForward" disabled="@(DebugCtl.CurrentSession is null || DebugCtl.CurrentSession.StepIndex >= DebugCtl.CurrentSession.Trace.Count - 1)" title="Step in (F11)"><i class="mdi mdi-debug-step-into icon-step-into"></i></button>
                    <button class="btn-dbg" data-dbg="step-out" @onclick="StepOut" disabled="@(DebugCtl.CurrentSession is null || DebugCtl.CurrentSession.StepIndex >= DebugCtl.CurrentSession.Trace.Count - 1)" title="Step out (F12)"><i class="mdi mdi-debug-step-out icon-step-out"></i></button>
                    <div class="dbg-controls-sep"></div>
                    <button class="btn-dbg btn-dbg-continue-back" data-dbg="continue-back" @onclick="ContinueToBreakpointBack" disabled="@(DebugCtl.CurrentSession is null || DebugCtl.CurrentSession.StepIndex <= 0)" title="Continue back (Shift+F5)"><i class="mdi mdi-play-outline btn-icon-mirror"></i></button>
                    <button class="btn-dbg" data-dbg="step-over-back" @onclick="StepOverBack" disabled="@(DebugCtl.CurrentSession is null || DebugCtl.CurrentSession.StepIndex <= 0)" title="Step over back (Shift+F10)"><i class="mdi mdi-debug-step-over btn-icon-mirror"></i></button>
                    <button class="btn-dbg" data-dbg="step-in-back" @onclick="StepBack" disabled="@(DebugCtl.CurrentSession is null || DebugCtl.CurrentSession.StepIndex <= 0)" title="Step in back (Shift+F11)"><i class="mdi mdi-debug-step-into icon-step-into-back"></i></button>
                    <button class="btn-dbg" data-dbg="step-out-back" @onclick="StepOutBack" disabled="@(DebugCtl.CurrentSession is null || DebugCtl.CurrentSession.StepIndex <= 0)" title="Step out back (Shift+F12)"><i class="mdi mdi-debug-step-out icon-step-out-back"></i></button>
                </div>
            }
        </div>

        <div class="topbar-right">
            <div class="share-button-wrap">
                <button class="btn-share" @onclick="CopyPermalink" title="Copy permalink to clipboard"><i class="mdi mdi-share-variant"></i></button>
                @if (permalinkCopied)
                {
                    <span class="permalink-toast" @key="permalinkToastKey">Permalink copied to clipboard</span>
                }
            </div>
            <button class="btn-run" @onclick="Run" disabled="@(RunCtl.IsRunning || DebugCtl.IsDebugging)" title="Run">
                @if (RunCtl.IsRunning)
                {
                    <span class="spinner"></span>
                }
                else
                {
                    <i class="mdi mdi-play"></i>
                }
            </button>
            @if (DebugCtl.IsDebugging)
            {
                <button class="btn-stop" @onclick="ExitDebug" title="Stop debugging"><i class="mdi mdi-stop"></i></button>
            }
            else
            {
                <button class="btn-debug-start" @onclick="StartDebug" disabled="@RunCtl.IsRunning" title="Debug (record execution trace)"><i class="mdi mdi-bug-outline"></i></button>
            }
        </div>
    </header>

    <div class="main-split">
        <EditorPanel @ref="editorPanel"
                     InitialCode="@initialEditorCode"
                     InitialCodeName="@(InitialCode.Name ?? "new.hlsl")"
                     InitialCodePath="@InitialCode.Path"
                     OnTabSwitched="@OnEditorTabSwitched"
                     OnReady="@Run" />

        <div class="resize-h-handle" title="Drag to resize"></div>

        <div class="output-panel">
            @if (DebugCtl.IsDebugging)
            {
                <VariablesPanel Step="@DebugCtl.CurrentSession?.Current" />

                <CallStackPanel Step="@DebugCtl.CurrentSession?.Current"
                                Mode="@debugBottomMode"
                                ModeChanged="@OnDebugBottomModeChanged"
                                OnlyThreadStates="@(State.DebugVertexIndex >= 0)"
                                OnExpand="@(() => needsThreadGridInit = true)" />

                <ImmediatePanel Session="@DebugCtl.CurrentSession"
                                DebugCode="@DebugCtl.DebugCode"
                                ParserConfig="@MakeParserConfig()" />

                <ConsolePanel Variant="ConsolePanel.ConsoleVariant.Debug"
                              HasError="@RunCtl.HasError" ErrorMessage="@RunCtl.ErrorMessage"
                              Output="@DebugCtl.CurrentDebugOutput" />

                <div class="debug-panel-spacer"></div>
            }
            else
            {
                <ColorOutputPanel IsGpuMode="@RunCtl.IsGpuMode" GpuPaused="@RunCtl.GpuPaused"
                                  GpuPreviewEnabledChanged="@OnGpuPreviewToggle"
                                  IsRunning="@RunCtl.IsRunning" IsDebugging="@DebugCtl.IsDebugging"
                                  IsCollapsed="@imageCollapsed"
                                  IsCollapsedChanged="@(c => imageCollapsed = c)"
                                  OnExpand="@OnImageSectionExpanded"
                                  OnToggleGpuPause="@RunCtl.ToggleGpuPauseAsync"
                                  OnRestartGpuTime="@RunCtl.RestartGpuTimeAsync" />

                <ConsolePanel Variant="ConsolePanel.ConsoleVariant.Run"
                              HasError="@RunCtl.HasError" ErrorMessage="@RunCtl.ErrorMessage"
                              Output="@RunCtl.Output" IsGpuPreview="@State.GpuPreviewEnabled" />

                <div class="debug-panel-spacer"></div>
            }
        </div>
    </div>
</div>

<SettingsModal @bind-IsOpen="showSettings" IsLocked="@(RunCtl.IsRunning || DebugCtl.IsDebugging)" />

<ExamplesModal @bind-IsOpen="showExamples" OnSelected="OnExampleSelected" />

<NewFileModal @bind-IsOpen="showNewFile" OnSelected="OnNewFileSelected" />

@code {
    private static readonly string DefaultCode =
@"static float TWIST = 12.0;
static float PERIOD = 32.0;
static float ARMS = 3.0;

float3 hueShift (float3 color, float shift)
{
    float3 axis = 0.55735;
    float3 grayscale = dot(0.55735, color);
    float3 radial = color - axis;
    float3 tangent = cross(axis, radial);
    return radial * cos(shift * 6.2832) +
        tangent * sin(shift * 6.2832) + axis;
}

float4 frag(float4 position : SV_Position) : SV_Target
{
    float2 uv = (position.xy / _Resolution) - 0.5;
    uv.x *= _Resolution.x/_Resolution.y;
    float dist = length(uv) + _Time*0.2;
    float angle = atan2(uv.y, uv.x) + 0.4;
    float wave = sin(dist * TWIST - angle * ARMS);
    wave = wave * 0.5 + 0.5;
    if (wave < 0.5)
    {
        PRINTF(""First branch taken due to %d wave value!"", wave);
        float3 base = float3(1.0, 0.3, 0.1);
        float3 color = hueShift(base, wave + dist);
        return float4(color, 1);
    }
    else
    {
        float periodic = sin(dist*PERIOD);
        float inverse = cos(dist*PERIOD);
        return float4(periodic, 0, inverse, 1);
    }
}
";

    private EditorPanel editorPanel;
    private string initialEditorCode = "";

    private async Task OnEditorTabSwitched(int newIndex)
    {
        if (DebugCtl.IsDebugging && newIndex == DebugCtl.DebugTabIndex && editorPanel != null)
            await editorPanel.HighlightLine(DebugCtl.CurrentDebugLine);
    }

    private CallStackPanel.DebugBottomMode debugBottomMode = CallStackPanel.DebugBottomMode.ThreadStates;

    private void OnDebugBottomModeChanged(CallStackPanel.DebugBottomMode v)
    {
        if (debugBottomMode == v) return;
        debugBottomMode = v;
        if (v == CallStackPanel.DebugBottomMode.PixelColors || v == CallStackPanel.DebugBottomMode.Both) needsImageRender = true;
        else needsThreadGridInit = true;
    }

    private async Task OnGpuPreviewToggle(bool v)
    {
        State.GpuPreviewEnabled = v;
        await Run();
    }

    private void OnImageSectionExpanded()
    {
        if (RunCtl.HasImage && RunCtl.ImagePixels != null) needsImageRender = true;
    }


    private bool showSettings = false;
    private bool showExamples = false;
    private bool showNewFile = false;
    private bool menuOpen = false;
    private bool permalinkCopied = false;
    private int permalinkToastKey = 0;
    private bool needsImageRender = false;

    private DotNetObjectReference<Debugger> dotNetRef;
    private bool needsThreadGridInit = false;
    private bool needsSectionHeightRestore = false;
    private bool imageCollapsed = false;

    protected override void OnInitialized()
    {
        dotNetRef = DotNetObjectReference.Create(this);
        State.PropertyChanged += OnStateChanged;
        RunCtl.PropertyChanged += OnStateChanged;
        DebugCtl.PropertyChanged += OnStateChanged;

        // Resolve initial code: permalink param wins over file-argument override, falls back to default.
        string code = InitialCode.Code ?? DefaultCode;
        var param = PermalinkCodec.GetQueryParam(Nav.Uri, "c");
        if (!string.IsNullOrEmpty(param))
        {
            try { code = PermalinkCodec.DecompressCode(param); }
            catch { }
        }
        initialEditorCode = code;
        State.ApplyFromUrl(Nav.Uri);
    }

    private void OnStateChanged(object sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        // Auto-expand the image section when GPU mode flips on so the canvas mounts before gpuRender.
        if (sender == RunCtl && e.PropertyName == nameof(RunController.IsGpuMode) && RunCtl.IsGpuMode)
            imageCollapsed = false;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            string objText = await JS.InvokeAsync<string>("dbgFetchText", "_content/HLSLInterpreter.Debugger/lib/monkey.obj");
            State.CurrentMesh = Mesh.ParseObj(objText);
        }
        catch (Exception ex) { Console.WriteLine("[default-mesh] " + ex.Message); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("setDebuggerRef", dotNetRef);

        if (needsSectionHeightRestore)
        {
            needsSectionHeightRestore = false;
            await JS.InvokeVoidAsync("restoreSectionHeights");
        }

        // The warp indicator overlay needs the warp size even in GPU mode, where
        // ImagePixels stays null. Push it unconditionally so the indicator works
        // before any CPU run has happened.
        await JS.InvokeVoidAsync("imgSetWarp", State.WarpX, State.WarpY);

        // imagestate.js applies this cache to image-containers as they mount,
        // so we don't have to race Blazor's render lifecycle.
        if (needsImageRender && RunCtl.ImagePixels != null)
        {
            needsImageRender = false;
            await JS.InvokeVoidAsync("restoreImageSectionHeight");
            await JS.InvokeVoidAsync("imgSetPixels", RunCtl.ImagePixels, RunCtl.ImageWidth, RunCtl.ImageHeight);
        }

        await JS.InvokeVoidAsync("imgSetRegularMode", RunCtl.IsGpuMode ? "gpu" : "cpu");
        string debugMode = DebugCtl.IsDebugging
            ? debugBottomMode switch
            {
                CallStackPanel.DebugBottomMode.Both => "both",
                CallStackPanel.DebugBottomMode.PixelColors => "debug",
                _ => "idle",
            }
            : "idle";
        await JS.InvokeVoidAsync("imgSetDebugMode", debugMode);

        if (DebugCtl.IsDebugging && State.WarpX > 0)
        {
            await JS.InvokeVoidAsync("imgSetDebugPixel",
                State.InspectedThread % State.WarpX, State.InspectedThread / State.WarpX);
            var states = DebugCtl.CurrentSession?.Current?.GetThreadStatesAt(State.SelectedFrame)
                ?? Array.Empty<HLSLExecutionState.ThreadState>();
            await JS.InvokeVoidAsync("imgSetThreadStates", states.Select(s => (int)s).ToArray());
            await JS.InvokeVoidAsync("imgSetCpuClickHandler", null, null);
            await JS.InvokeVoidAsync("imgSetDebugClickHandler", true);
        }
        else
        {
            await JS.InvokeVoidAsync("imgSetDebugPixel", null, null);
            await JS.InvokeVoidAsync("imgSetThreadStates", (int[])null);
            await JS.InvokeVoidAsync("imgSetDebugClickHandler", false);
            if (!RunCtl.IsGpuMode)
                await JS.InvokeVoidAsync("imgSetCpuClickHandler", State.WarpX, State.WarpY);
            else
                await JS.InvokeVoidAsync("imgSetCpuClickHandler", null, null);
        }

        // Vertex picking only applies in vert/frag mode and outside the debug
        // session itself. Push the mesh positions and current pick mode.
        bool vertexPicking = !DebugCtl.IsDebugging
            && State.ShaderRenderMode == ShaderRenderMode.VertFrag
            && State.DebugTarget == DebugTarget.Vertex;
        await JS.InvokeVoidAsync("imgSetPickMode", vertexPicking ? "vertex" : "pixel");
        await JS.InvokeVoidAsync("imgSetMeshData",
            vertexPicking ? State.CurrentMesh.Positions : null,
            vertexPicking ? State.CurrentMesh.Indices : null);

        if (needsThreadGridInit)
        {
            needsThreadGridInit = false;
            await JS.InvokeVoidAsync("initThreadGridResize", "thread-grid-container", State.WarpX, State.WarpY);
        }
    }

    private async Task Run()
    {
        if (editorPanel == null) return;
        await RunCtl.RunAsync(
            getCode: () => editorPanel.GetCode().AsTask(),
            parserConfig: MakeParserConfig(),
            dotNetRef: dotNetRef,
            beforeGpuRender: async () =>
            {
                imageCollapsed = false;
                StateHasChanged();
                await Task.Yield();
            });
        needsImageRender = RunCtl.HasImage;
    }

    [JSInvokable]
    public async Task LoadObjMesh(string objText)
    {
        if (string.IsNullOrWhiteSpace(objText)) return;
        try
        {
            State.CurrentMesh = Mesh.ParseObj(objText);
        }
        catch (Exception ex)
        {
            RunCtl.HasError = true;
            RunCtl.ErrorMessage = "Failed to load OBJ: " + ex.Message;
            StateHasChanged();
            return;
        }
        await Run();
    }

    [JSInvokable]
    public void SetInspectedPixel(int px, int py)
    {
        if (State.WarpX <= 0) return;
        State.InspectedThread = py * State.WarpX + px;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task StartDebugAtPixel(int px, int py, float time, int canvasW, int canvasH)
    {
        int wx = Math.Max(1, State.WarpX);
        int wy = Math.Max(1, State.WarpY);
        DebugCtl.SaveGroupOffsetsForRestore();
        State.GroupOffsetX = px / wx;
        State.GroupOffsetY = py / wy;
        State.InspectedThread = (py % wy) * wx + (px % wx);
        RunCtl.GpuCaptured = (time, canvasW, canvasH);

        await StartDebug();
    }

    [JSInvokable]
    public async Task StartDebugAtVertex(int vertexIndex, float time, int canvasW, int canvasH)
    {
        int warpSize = Math.Max(1, State.WarpX * State.WarpY);
        State.InspectedThread = vertexIndex % warpSize;
        State.DebugVertexIndex = vertexIndex;
        RunCtl.GpuCaptured = (time, canvasW, canvasH);
        if (debugBottomMode != CallStackPanel.DebugBottomMode.ThreadStates)
        {
            debugBottomMode = CallStackPanel.DebugBottomMode.ThreadStates;
            needsThreadGridInit = true;
        }

        await StartDebug();
    }

    private async Task StartDebug()
    {
        if (editorPanel == null) return;

        if (State.ShaderRenderMode == ShaderRenderMode.VertFrag
            && State.DebugTarget == DebugTarget.Vertex
            && State.DebugVertexIndex < 0)
        {
            await StartDebugAtVertex(0, RunCtl.GpuCaptured?.Time ?? 0f,
                RunCtl.GpuCaptured?.CanvasW ?? Math.Max(1, State.WarpX),
                RunCtl.GpuCaptured?.CanvasH ?? Math.Max(1, State.WarpY));
            return;
        }

        await JS.InvokeVoidAsync("saveSectionHeights");

        bool entered = await DebugCtl.StartSessionAsync(
            getCode: () => editorPanel.GetCode().AsTask(),
            parserConfig: MakeParserConfig());
        needsImageRender = RunCtl.HasImage;

        if (!entered)
        {
            needsSectionHeightRestore = true;
            return;
        }

        await editorPanel.SetReadOnly(true);
        DebugCtl.DebugTabIndex = editorPanel.ActiveTabIndex;
        imageCollapsed = true;
        if (DebugCtl.CurrentSession?.Trace.Count > 0)
            await editorPanel.HighlightLine(DebugCtl.CurrentDebugLine);

        needsSectionHeightRestore = true;
        needsThreadGridInit = true;
    }

    private async Task EnsureOnDebugTab()
    {
        if (editorPanel == null) return;
        if (DebugCtl.DebugTabIndex >= 0 && editorPanel.ActiveTabIndex != DebugCtl.DebugTabIndex)
            await editorPanel.SwitchTab(DebugCtl.DebugTabIndex);
    }

    private async Task StepForward()      => await NavigateAndHighlight(() => DebugCtl.StepForward());
    private async Task StepBack()         => await NavigateAndHighlight(() => DebugCtl.StepBack());
    private async Task StepOver()         => await NavigateAndHighlight(() => DebugCtl.StepOver());
    private async Task StepOut()          => await NavigateAndHighlight(() => DebugCtl.StepOut());
    private async Task StepOverBack()     => await NavigateAndHighlight(() => DebugCtl.StepOverBack());
    private async Task StepOutBack()      => await NavigateAndHighlight(() => DebugCtl.StepOutBack());
    private async Task ContinueToBreakpoint()     => await NavigateAndHighlight(() => DebugCtl.ContinueToBreakpoint());
    private async Task ContinueToBreakpointBack() => await NavigateAndHighlight(() => DebugCtl.ContinueToBreakpointBack());

    private async Task NavigateAndHighlight(Action move)
    {
        await EnsureOnDebugTab();
        if (DebugCtl.CurrentSession == null) return;
        move();
        if (editorPanel != null) await editorPanel.HighlightLine(DebugCtl.CurrentDebugLine);
    }

    private async Task ExitDebug()
    {
        await JS.InvokeVoidAsync("saveSectionHeights");
        DebugCtl.ExitSession();
        if (editorPanel != null)
        {
            await editorPanel.SetReadOnly(false);
            await editorPanel.HighlightLine(0);
        }
        imageCollapsed = false;
        await JS.InvokeVoidAsync("disposeThreadGridResize");
        needsSectionHeightRestore = true;
        if (State.GpuPreviewEnabled) await Run();
    }

    private async Task MenuCopyPermalink()
    {
        menuOpen = false;
        await CopyPermalink();
    }

    private void MenuOpenSettings()
    {
        menuOpen = false;
        showSettings = true;
    }

    private async Task MenuDownloadCurrentFile()
    {
        menuOpen = false;
        if (editorPanel == null) return;
        string code = await editorPanel.GetCode();
        string filename = string.IsNullOrWhiteSpace(editorPanel.ActiveTabName) ? "shader.hlsl" : editorPanel.ActiveTabName;
        await JS.InvokeVoidAsync("downloadTextFile", filename, code);
    }

    private void MenuOpenExamples()
    {
        menuOpen = false;
        showExamples = true;
    }

    private void MenuNewFile()
    {
        menuOpen = false;
        showNewFile = true;
    }

    private async Task OnNewFileSelected(HLSLInterpreter.Debugger.Components.NewFileModal.NewFileTemplate t)
    {
        if (editorPanel == null) return;
        if (DebugCtl.IsDebugging) await ExitDebug();
        await editorPanel.LoadContent(t.FileName, t.Content);
        if (t.Mode.HasValue) State.ShaderRenderMode = t.Mode.Value;
        if (!string.IsNullOrWhiteSpace(t.FragEntry)) State.FragmentEntryPoint = t.FragEntry;
        if (!string.IsNullOrWhiteSpace(t.VertEntry)) State.VertexEntryPoint = t.VertEntry;
    }

    private async Task MenuOpenFile()
    {
        menuOpen = false;
        if (editorPanel != null) await editorPanel.OpenFileDialog();
    }

    private async Task MenuSaveFile()
    {
        menuOpen = false;
        if (editorPanel != null) await editorPanel.SaveFileDialog();
    }

    private async Task MenuSaveFileAs()
    {
        menuOpen = false;
        if (editorPanel != null) await editorPanel.SaveFileAsDialog();
    }

    private async Task OnExampleSelected(HLSLInterpreter.Debugger.Components.ExamplesModal.ExampleSelection ex)
    {
        if (editorPanel == null) return;
        if (DebugCtl.IsDebugging) await ExitDebug();
        await editorPanel.LoadContent(ex.Name, ex.Content);
        if (ex.Mode.HasValue) State.ShaderRenderMode = ex.Mode.Value;
        if (!string.IsNullOrWhiteSpace(ex.FragEntry)) State.FragmentEntryPoint = ex.FragEntry;
        if (!string.IsNullOrWhiteSpace(ex.VertEntry)) State.VertexEntryPoint = ex.VertEntry;
        await Run();
    }

    private async Task CopyPermalink()
    {
        string code = editorPanel != null ? await editorPanel.GetCode() : "";
        string baseUrl = PermalinkBase.Url ?? new Uri(Nav.Uri).GetLeftPart(UriPartial.Path);
        await PermalinkCodec.CopyToClipboardAsync(JS, code, baseUrl, State.ToPermalinkSettings());

        int newKey = ++permalinkToastKey;
        permalinkCopied = true;
        StateHasChanged();
        await Task.Delay(1500);
        if (permalinkToastKey == newKey)
        {
            permalinkCopied = false;
            StateHasChanged();
        }
    }

    private HLSLParserConfig MakeParserConfig()
    {
        string filePath = editorPanel?.ActiveTabPath;
        return new HLSLParserConfig
        {
            BasePath = filePath != null ? System.IO.Path.GetDirectoryName(filePath) ?? "" : ""
        };
    }

    public async ValueTask DisposeAsync()
    {
        State.PropertyChanged -= OnStateChanged;
        RunCtl.PropertyChanged -= OnStateChanged;
        DebugCtl.PropertyChanged -= OnStateChanged;
        dotNetRef?.Dispose();
        await JS.InvokeVoidAsync("highlightDebugLine", 0);
        await JS.InvokeVoidAsync("setBreakpoints", Array.Empty<int>());
    }
}
